    require_adb
    select_device
    load_packages

    say ""
    if [ -z "$term" ]; then
        say "Pacotes Samsung/Google/terceiros instalados:"
        term=""
    else
        say "Pacotes instalados que contêm '$term':"
    fi

    local pkg mark
    while IFS= read -r pkg; do
        case "$pkg" in
            com.samsung*|com.sec.*|com.osp.*|com.google.*|com.android.*|com.microsoft.*|com.facebook.*|com.netflix.*) ;;
            *) continue ;;
        esac
        if [ -n "$term" ]; then
