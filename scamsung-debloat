# contadores globais
REMOVED=0; DISABLED=0; ALREADY=0; MISSING=0; FAILED=0; BLOCKED=0; WILL=0
TARGET_LABEL=""

while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)     ASSUME_YES=1; shift ;;
        --disable)    METHOD="disable"; shift ;;
        --skip)       [ $# -ge 2 ] || die "--skip precisa de argumento"; SKIP="$2"; shift 2 ;;
        --only)       [ $# -ge 2 ] || die "--only precisa de argumento"; ONLY="$2"; shift 2 ;;
        -s|--serial)  [ $# -ge 2 ] || die "--serial precisa de argumento"; SERIAL="$2"; shift 2 ;;
        -v|--verbose) VERBOSE=1; shift ;;
        -q|--quiet)   QUIET=1; shift ;;
        -h|--help)    usage; exit 0 ;;
        --)           shift; break ;;
        --categories) err "--categories não existe mais: use ./scamsung-debloat apply <preset>"; exit 1 ;;
        -*)           err "opção desconhecida: $1"; usage; exit 1 ;;
        *)            break ;;
    esac
done

CMD="${1:-menu}"
[ $# -gt 0 ] && shift

# opções também aceitas depois do subcomando (ex.: apply basic --dry-run)
if [ "$CMD" = "apply" ]; then
    ARGS=""
    while [ $# -gt 0 ]; do
        case "$1" in
                -y|--yes)     ASSUME_YES=1; shift ;;
            --disable)    METHOD="disable"; shift ;;
            --skip)       [ $# -ge 2 ] || die "--skip precisa de argumento"; SKIP="$2"; shift 2 ;;
            --only)       [ $# -ge 2 ] || die "--only precisa de argumento"; ONLY="$2"; shift 2 ;;
                -v|--verbose) VERBOSE=1; shift ;;
            -q|--quiet)   QUIET=1; shift ;;
            --categories) err "--categories não existe mais: use ./scamsung-debloat apply <preset>"; exit 1 ;;
            -*)           err "opção desconhecida: $1"; exit 1 ;;
            *)            ARGS="$ARGS $1"; shift ;;
        esac
    done
    set -- $ARGS
fi

init_work_dir

case "$CMD" in
    menu)      menu ;;
    doctor)    cmd_doctor ;;
    status)    cmd_status ;;
    list)      cmd_list ;;
    apply)     cmd_apply "${1:-}" ;;
    restore)   cmd_restore ;;
    scan)      cmd_scan "${1:-}" ;;
    explain)   cmd_explain "${1:-}" ;;
    tweaks)    cmd_tweaks "${1:-}" "${2:-}" ;;
    wireless)  cmd_wireless ;;
    self-test) cmd_self_test ;;
    help|-h|--help) usage ;;
    shell)
        require_adb
        select_device
        adb_run shell "$@"
        ;;
    *) err "comando desconhecido: $CMD"; usage; exit 1 ;;
esac
