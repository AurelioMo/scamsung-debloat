# RAM Plus: só mexe se a chave existir no firmware.
cmd_tweaks_ram_plus() {
    local mode="$1" cur
    case "$mode" in
        off|0|disable)
            step "$(m tweaks_ram_plus_01)"
            cur="$(tweak_get ram_expand_size)"
            if [ "$cur" = "0" ]; then
                dim "$(m tweaks_ram_plus_02)"
            elif [ -z "$cur" ]; then
                warn "$(m tweaks_ram_plus_03)"
                say "$(m tweaks_ram_plus_04)"
            else
                tweak_apply ram_expand_size 0 "$(m twdesc_ramplus_solo)"
            fi
            ;;
        on|auto|default|reset)
            step "$(m tweaks_ram_plus_05)"
            tweak_clear ram_expand_size
            ;;
        *)
            err "$(m tweaks_ram_plus_06)"
            return 1
            ;;
    esac
}

cmd_tweaks() {
    local sub="${1:-}" extra="${2:-}"
    TW_CHANGED=0; TW_SAME=0; TW_IGNORED=0; TW_SKIPPED=0

    case "$sub" in
        --status|status)
            cmd_tweaks_status
            return 0
            ;;
        --defaults)
            # limpa só o registro local, sem tocar no aparelho
            if [ -f "$TWEAKS_FILE" ]; then
                : > "$TWEAKS_FILE"
                ok "$(m tweaks_01)"
            else
                dim "$(m tweaks_02)"
            fi
            return 0
            ;;
    esac

    require_adb
    select_device
    load_device_info
    say ""
    print_device_header

    case "$sub" in
        ''|apply)
            cmd_tweaks_apply
            ;;
        --reset|reset)
            cmd_tweaks_reset
            ;;
        --ram-plus|ram-plus)
            cmd_tweaks_ram_plus "$extra" || return 1
            ;;
        --performance|performance|--full|full)
            cmd_tweaks_performance
            ;;
        *)
            err "$(m tweaks_03 "$sub")"
            say ""
            say "$(m tweaks_04)"
            say "$(m tweaks_05)"
            say "$(m tweaks_06)"
            say "$(m tweaks_07)"
            say "$(m tweaks_08)"
            return 1
            ;;
    esac

    say ""
    dim "$(m tweaks_09)"
}

cmd_wireless() {
    require_adb
    say ""
    say "$(m wireless_01)"
    say "$(m wireless_02)"
    say ""
    printf '%s' "$(m wireless_prompt1)"
    read -r pair_addr
    printf '%s' "$(m wireless_prompt2)"
    read -r pair_code
    [ -z "$pair_addr" ] || [ -z "$pair_code" ] && die "$(m die_pair_data)"

    "$ADB" pair "$pair_addr" "$pair_code" || warn "$(m wireless_pair_warn)"

    say ""
    printf '%s' "$(m wireless_prompt3)"
    read -r conn_addr
    [ -z "$conn_addr" ] && die "$(m die_conn_empty)"

    "$ADB" connect "$conn_addr"
    say ""
    "$ADB" devices | tr -d '\r'
}

cmd_self_test() {
    local errors=0 warnings=0 f preset line pkg lineno dup missing next
    step "$(m self_test_01)"

    if [ ! -d "$LISTS_DIR" ]; then
        err "$(m self_test_02 "$LISTS_DIR")"
        return 1
    fi

    for f in "$LISTS_DIR"/*.txt; do
        [ -f "$f" ] || continue
        preset="$(basename "$f" .txt)"
        lineno=0
        while IFS= read -r line || [ -n "$line" ]; do
            lineno=$((lineno + 1))
            case "$line" in
                ''|'#'*) continue ;;
            esac
            pkg="$(strip_line "$line")"
            [ -z "$pkg" ] && continue
            case "$line" in
                *'#'*) ;;
                *)
                    err "$(m self_test_03 "$preset" "$lineno")"
                    errors=$((errors + 1))
                    ;;
            esac
            case "$pkg" in
                *[!A-Za-z0-9._]*)
                    err "$(m self_test_04 "$preset" "$lineno" "$pkg")"
                    errors=$((errors + 1))
                    continue
                    ;;
            esac
            if ! printf '%s' "$pkg" | grep -Eq '^[A-Za-z0-9_]+(\.[A-Za-z0-9_]+)+$'; then
                err "$(m self_test_05 "$preset" "$lineno" "$pkg")"
                errors=$((errors + 1))
            fi
            if is_denied "$pkg"; then
                err "$(m self_test_06 "$preset" "$pkg")"
                errors=$((errors + 1))
            fi
        done < "$f"

        dup="$(read_preset "$f" | sort | uniq -d)"
        if [ -n "$dup" ]; then
            while IFS= read -r pkg; do
                [ -z "$pkg" ] && continue
                err "$(m self_test_07 "$preset" "$pkg")"
                errors=$((errors + 1))
            done <<EOF
$dup
EOF
        fi
    done

    for preset in basic light heavy; do
        if [ ! -f "$(preset_path "$preset")" ]; then
            err "$(m self_test_08 "$preset")"
            errors=$((errors + 1))
        fi
    done

    # heavy contém light, light contém basic
    local nest_a nest_b
    for preset in basic light; do
        case "$preset" in
            basic) next="light" ;;
            light) next="heavy" ;;
        esac
        [ -f "$(preset_path "$preset")" ] || continue
        [ -f "$(preset_path "$next")" ] || continue
        nest_a="$(work_file nest-small.txt)"
        nest_b="$(work_file nest-big.txt)"
        read_preset "$(preset_path "$preset")" | sort -u > "$nest_a"
        read_preset "$(preset_path "$next")" | sort -u > "$nest_b"
        missing="$(comm -23 "$nest_a" "$nest_b")"
        if [ -n "$missing" ]; then
            while IFS= read -r pkg; do
                [ -z "$pkg" ] && continue
                err "$(m self_test_09 "$pkg" "$preset" "$next")"
                errors=$((errors + 1))
            done <<EOF
$missing
EOF
        fi
    done

    step "$(m selftest_lang_step)"
    local base n
    base="$(grep -c '^MSG_' "$LANG_DIR/pt-BR.sh" 2>/dev/null || echo 0)"
    for lf in en es; do
        n="$(grep -c '^MSG_' "$LANG_DIR/$lf.sh" 2>/dev/null || echo 0)"
        if [ "$n" != "$base" ]; then
            warn "$(m selftest_lang_count "$lf" "$n" "$base")"
            warnings=$((warnings + 1))
        fi
    done
    dim "$(m selftest_lang_ok "$base")"

    say ""
    if [ "$errors" -eq 0 ]; then
        [ "$warnings" -gt 0 ] && warn "$(m selftest_warns "$warnings")"
        ok "$(m self_test_10)"
        return 0
    fi
    err "$(m self_test_11 "$errors" "$warnings")"
    return 1
}

