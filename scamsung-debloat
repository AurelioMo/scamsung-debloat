}

cmd_doctor() {
    say ""
    printf '%s%s %s%s\n' "$C_BOLD" "$APP_NAME" "$APP_VERSION" "$C_RESET"

    step "$(m doctor_01)"
    say "$(m doctor_02 "$(host_os)" "${BASH_VERSION:-desconhecido}")"
    say "$(m doctor_03 "$LISTS_DIR")"
    say "$(m doctor_04 "$DATA_DIR")"

    step "$(m doctor_05)"
    if find_adb; then
        ok "$(m doctor_06 "$ADB")"
        say "$(m doctor_07 "$("$ADB" version 2>/dev/null | tr -d '\r' | head -n 1)")"
    else
        err "$(m doctor_08)"
        install_hint
        exit 1
    fi

    step "$(m doctor_09)"
    select_device
    load_device_info
    ok "$(m doctor_10 "$MODEL" "$DEVICE_CODE" "$SERIAL")"
    say "$(m doctor_11 "$ANDROID_VER" "$ONEUI_LABEL")"

    step "$(m doctor_12)"
    if sh_run true | grep -q .; then
        warn "$(m doctor_13)"
    else
        ok "$(m doctor_14)"
    fi

    if sh_run pm list packages --user 0 | grep -q '^package:'; then
        ok "$(m doctor_15)"
    else
        err "$(m doctor_16)"
        exit 1
    fi

    case "$(sh_run cmd package help 2>&1)" in
        *install-existing*) ok "$(m doctor_install_existing_ok)" ;;
        *) warn "$(m doctor_install_existing_warn)" ;;
    esac

    step "$(m doctor_17)"
    say "$(m doctor_18 "$STATE_FILE")"
    if [ -s "$STATE_FILE" ]; then
        warn "$(m doctor_19 "$(grep -c . "$STATE_FILE" | tr -d ' ')")"
    else
        ok "$(m doctor_20)"
    fi
