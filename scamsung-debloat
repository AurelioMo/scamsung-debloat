# ---------------------------------------------------------------------------
# tweaks (equivalente ao Tweaks.bat, mas com verificação e reset exato)
# ---------------------------------------------------------------------------

# Devolve o valor atual de um global setting. Vazio = chave inexistente/null.
tweak_get() {
    local v
    v="$(sh_run settings get global "$1" | head -n 1)"
    case "$v" in
        ''|null|Null|NULL) printf '' ;;
        *) printf '%s' "$v" ;;
    esac
}

# Guarda o valor original só na primeira vez (primeiro write ganha).
tweak_record() {
    local key="$1" old="${2:-}"
    mkdir -p "$DATA_DIR" || return 0
    if [ -f "$TWEAKS_FILE" ] && \
       awk -F'\t' -v k="$key" '$1==k{found=1} END{exit !found}' "$TWEAKS_FILE"; then
        return 0
    fi
    printf '%s\t%s\n' "$key" "$old" >> "$TWEAKS_FILE"
}

tweak_forget() {
    local key="$1" tmp
    [ -f "$TWEAKS_FILE" ] || return 0
    tmp="${TWEAKS_FILE}.tmp.$$"
    awk -F'\t' -v k="$key" '$1!=k' "$TWEAKS_FILE" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$TWEAKS_FILE"
}

# Aplica um setting e confere se o firmware aceitou.
tweak_apply() {
    local key="$1" value="$2" desc="${3:-}" optional="${4:-}" cur now
    cur="$(tweak_get "$key")"

    if [ -n "$optional" ] && [ -z "$cur" ]; then
        dim "  - $key não existe neste firmware (pulado)"
        TW_SKIPPED=$((TW_SKIPPED + 1))
        return 0
    fi

    if [ "$cur" = "$value" ]; then
        dim "  = $key já está em $value"
        TW_SAME=$((TW_SAME + 1))
        return 0
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        say "  ~ $key: ${cur:-null} -> $value"
        [ -n "$desc" ] && dim "      $desc"
        TW_CHANGED=$((TW_CHANGED + 1))
        return 0
    fi

    tweak_record "$key" "$cur"
    sh_run settings put global "$key" "$value" >/dev/null
    now="$(tweak_get "$key")"

    if [ "$now" = "$value" ]; then
        ok "  + $key = $value"
        [ -n "$desc" ] && dim "      $desc"
        TW_CHANGED=$((TW_CHANGED + 1))
    else
        warn "  ! $key não aceitou $value (firmware devolveu '${now:-null}')"
        TW_IGNORED=$((TW_IGNORED + 1))
    fi
}

# Remove uma chave (volta ao default do sistema).
tweak_clear() {
    local key="$1" cur now
    cur="$(tweak_get "$key")"
    if [ -z "$cur" ]; then
        dim "  = $key já está no padrão"
        TW_SAME=$((TW_SAME + 1))
        return 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        say "  ~ $key: ${cur} -> padrão"
        TW_CHANGED=$((TW_CHANGED + 1))
        return 0
    fi
    tweak_record "$key" "$cur"
    sh_run settings delete global "$key" >/dev/null 2>&1
    now="$(tweak_get "$key")"
    if [ -z "$now" ]; then
        ok "  + $key removido (padrão do sistema)"
        TW_CHANGED=$((TW_CHANGED + 1))
    else
        warn "  ! $key continua em '${now}'"
        TW_IGNORED=$((TW_IGNORED + 1))
    fi
}

# Ações em pacotes (GOS) registradas no mesmo arquivo, com prefixo pkg:
tweak_record_pkg() {
    local pkg="$1"
    mkdir -p "$DATA_DIR" || return 0
    if [ -f "$TWEAKS_FILE" ] && \
       awk -F'\t' -v k="pkg:$pkg" '$1==k{found=1} END{exit !found}' "$TWEAKS_FILE"; then
        return 0
    fi
    printf 'pkg:%s\t0\n' "$pkg" >> "$TWEAKS_FILE"
}

tweak_disable_pkg() {
    local pkg="$1" desc="${2:-}" out
    if sh_run pm list packages -d --user 0 | sed -n 's/^package://p' | grep -Fxq "$pkg"; then
        dim "  = $pkg já está desativado"
        TW_SAME=$((TW_SAME + 1))
        return 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        say "  ~ desativar pacote $pkg"
        [ -n "$desc" ] && dim "      $desc"
        TW_CHANGED=$((TW_CHANGED + 1))
        return 0
    fi
    tweak_record_pkg "$pkg"
    out="$(sh_run pm disable-user --user 0 "$pkg")"
    case "$out" in
        *disabled*|*Success*)
            ok "  + pacote desativado: $pkg"
            [ -n "$desc" ] && dim "      $desc"
            TW_CHANGED=$((TW_CHANGED + 1))
            ;;
        *)
            warn "  ! não consegui desativar $pkg ($out)"
            TW_IGNORED=$((TW_IGNORED + 1))
            ;;
    esac
}

tweak_enable_pkg() {
    local pkg="$1" out
    out="$(sh_run pm enable "$pkg")"
    case "$out" in
        *enabled*|*Success*)
            ok "  + pacote reativado: $pkg"
            tweak_forget "pkg:$pkg"
            return 0
            ;;
        *)
            err "  x não consegui reativar $pkg ($out)"
            return 1
            ;;
    esac
}

cmd_tweaks_status() {
    step "Ajustes aplicados por este script"
    if [ ! -s "$TWEAKS_FILE" ]; then
        say "  nenhum (arquivo $TWEAKS_FILE vazio ou inexistente)"
        return 0
    fi
    awk -F'\t' '{
        if ($1 ~ /^pkg:/) printf "  pacote  %-38s (desativado)\n", substr($1, 5)
        else             printf "  setting %-38s original: %s\n", $1, ($2 == "" ? "(null)" : $2)
    }' "$TWEAKS_FILE"
    say ""
    dim "  reverter todos: ./scamsung-debloat tweaks --reset"
}

cmd_tweaks_reset() {
    local key old now total=0 changed=0 failed=0
    if [ ! -s "$TWEAKS_FILE" ]; then
        ok "  nada para reverter (nenhum ajuste registrado)."
        say ""
        dim "  Se você aplicou o Tweaks.bat antigo, use:"
        dim "    ./scamsung-debloat tweaks --defaults"
        return 0
    fi

    step "Revertendo ajustes registrados"
    while IFS="$(printf '\t')" read -r key old || [ -n "$key" ]; do
        [ -z "$key" ] && continue
        total=$((total + 1))
        if [ "$DRY_RUN" -eq 1 ]; then
            case "$key" in
                pkg:*) say "  ~ reativar ${key#pkg:}" ;;
                *)     say "  ~ $key -> ${old:-(null)}" ;;
            esac
            changed=$((changed + 1))
            continue
        fi
        case "$key" in
            pkg:*)
                if tweak_enable_pkg "${key#pkg:}"; then
                    changed=$((changed + 1))
                else
                    failed=$((failed + 1))
                fi
                continue
                ;;
        esac
        if [ -z "$old" ]; then
            sh_run settings delete global "$key" >/dev/null 2>&1
        else
            sh_run settings put global "$key" "$old" >/dev/null
        fi
        now="$(tweak_get "$key")"
        if [ "$now" = "$old" ]; then
            ok "  + $key = ${old:-(padrão)}"
            tweak_forget "$key"
            changed=$((changed + 1))
        else
            err "  x $key não voltou para '${old:-(padrão)}' (agora '${now:-null}')"
            failed=$((failed + 1))
        fi
    done < "$TWEAKS_FILE"

    say ""
    say "  revertidos: $changed de $total"
    [ "$failed" -gt 0 ] && err "  falhas: $failed (continuam registradas para nova tentativa)"
    [ "$DRY_RUN" -eq 0 ] && [ "$failed" -eq 0 ] && : > "$TWEAKS_FILE"
    return 0
}

