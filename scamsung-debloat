menu() {
    local choice p t
    while true; do
        printf '\n%s%s %s%s\n' "$C_BOLD" "$APP_NAME" "$APP_VERSION" "$C_RESET"
        printf '  1) Diagnóstico do aparelho\n'
        printf '  2) Aplicar preset (basic, light, heavy)\n'
        printf '  3) Ver o que você já removeu\n'
        printf '  4) Restaurar tudo\n'
        printf '  5) Tweaks (GOS, RAM Plus, animações...)\n'
        printf '  6) Ver pacotes instalados (scan)\n'
        printf '  7) Parear por Wi-Fi\n'
        printf '  8) Sair\n'
        printf 'Escolha: '
        read -r choice
        case "$choice" in
            1) cmd_doctor ;;
            2)
                printf '\nPresets: %s\n' "$(list_presets | tr '\n' ' ')"
                printf 'Qual preset? '
                read -r p
                [ -n "$p" ] && cmd_apply "$p"
                ;;
            3) cmd_status ;;
            4) cmd_restore ;;
            5)
                printf '\n%sTweaks%s — tudo aqui é reversível com a opção r.\n' "$C_BOLD" "$C_RESET"
                printf '  \n'
                printf '  p) performance  %s(recomendado para jogos)%s\n' "$C_BOLD" "$C_RESET"
                printf '     - desativa o GOS: jogos param de ser limitados pela Samsung\n'
                printf '     - desliga RAM Plus e zram (swap em armazenamento)\n'
                printf '     - animações a 0.35x (valor do Tweaks.bat original)\n'
                printf '     - desliga o controle térmico de jogos\n'
                printf '     Preço: mais calor sob carga, multitarefa pode reabrir mais apps\n'
                printf '     e as estatísticas do GOS são apagadas (pm clear).\n'
                printf '  \n'
                printf '  a) leves        o pacotinho de bom senso\n'
                printf '     - animações a 0.5x\n'
                printf '     - freezer de apps em background\n'
                printf '     - bateria adaptativa ligada\n'
                printf '     - menos varredura de Wi-Fi/Bluetooth em segundo plano\n'
                printf '  \n'
                printf '  s) status       mostra o que este script já mudou e o valor original\n'
                printf '  r) resetar      devolve exatamente o que ESTE script mudou\n'
                printf '  \n'
                printf 'Qual? [p]: '
                read -r t
                case "$t" in
                    a|A) cmd_tweaks ;;
                    s|S) cmd_tweaks --status ;;
                    r|R) cmd_tweaks --reset ;;
                    ''|p|P) cmd_tweaks --performance ;;
                    *) warn "opção inválida." ;;
                esac
                ;;
            6)
                printf 'Termo (enter = todos): '
                read -r t
                cmd_scan "$t"
                ;;
            7) cmd_wireless ;;
            8) exit 0 ;;
            '') ;;
            *) warn "opção inválida." ;;
        esac
    done
}

