}

cmd_list() {
    local f count desc
    step "$(m list_01)"
    for f in "$LISTS_DIR"/*.txt; do
        [ -f "$f" ] || continue
        count="$(read_preset "$f" | grep -c . || true)"
        desc="$(sed -n '1s/^# *//p' "$f")"
        printf '  %-6s %3s pacotes  %s\n' "$(basename "$f" .txt)" "$count" "$desc"
    done
    say ""
    dim "$(m list_02)"
}

cmd_scan() {
    local term="${1:-}"
    require_adb
    select_device
    load_packages

    say ""
    if [ -z "$term" ]; then
        say "$(m scan_01)"
        term=""
    else
        say "$(m scan_02 "$term")"
    fi

    local pkg mark
    while IFS= read -r pkg; do
        case "$pkg" in
            com.samsung*|com.sec.*|com.osp.*|com.google.*|com.android.*|com.microsoft.*|com.facebook.*|com.netflix.*) ;;
            *) continue ;;
        esac
        if [ -n "$term" ]; then
            printf '%s' "$pkg" | grep -qi -- "$term" || continue
        fi
        mark=""
        if is_denied "$pkg"; then
            mark="${C_RED}[protegido]${C_RESET}"
        elif list_contains "$pkg"; then
            mark="${C_GREEN}[na lista]${C_RESET}"
        fi
        printf '  %-55s %s\n' "$pkg" "$mark"
    done < "$PKG_INSTALLED"
    say ""
    dim "$(m scan_03)"
    dim "$(m scan_04)"
}

cmd_explain() {
    local pkg="${1:-}" f preset line label="" found=0 presets="" action o canon
    if [ -z "$pkg" ]; then
        err "$(m explain_01)"
        say "$(m explain_02)"
        return 1
    fi
    pkg="$(printf '%s' "$pkg" | sed 's/^package://')"

    say ""
    printf '%s%s%s\n' "$C_BOLD" "$pkg" "$C_RESET"

    for f in "$LISTS_DIR"/*.txt; do
        [ -f "$f" ] || continue
        line="$(grep -E "^[[:space:]]*$pkg([[:space:]]|$)" "$f" | head -n 1)"
        [ -z "$line" ] && continue
        found=1
        preset="$(basename "$f" .txt)"
        presets="$presets $preset"
        if [ -z "$label" ]; then
            label="$(printf '%s' "$line" | sed -n 's/^[^#]*#[[:space:]]*//p')"
        fi
    done

    [ -n "$label" ] && printf '%s\n' "$(m explain_label "$label")"
    if [ "$found" -eq 1 ]; then
        canon=""
        for o in basic light heavy; do
            case " $presets " in
                *" $o "*) canon="$canon $o" ;;
            esac
        done
        printf '%s\n' "$(m explain_presets "$(printf '%s' "$canon" | sed 's/^ *//')")"
    else
        dim "$(m explain_03)"
    fi

    if is_denied "$pkg"; then
        printf '%s\n' "$(m explain_denied "$C_RED" "$C_RESET")"
    else
        printf '%s\n' "$(m explain_not_denied)"
    fi

    if [ -f "$STATE_FILE" ]; then
        action="$(awk -F'\t' -v p="$pkg" '$2==p{print $1; exit}' "$STATE_FILE" 2>/dev/null)"
        if [ -n "$action" ]; then
            printf '%s\n' "$(m explain_state "$action")"
        fi
    fi

    if [ "$found" -eq 0 ] && ! is_denied "$pkg"; then
        say ""
        dim "$(m explain_04)"
        dim "$(m explain_05)"
    fi
    say ""
    return 0
}

list_contains() {
    local pkg="$1" f
    [ -z "$ALL_LIST_CACHE" ] && ALL_LIST_CACHE="$(work_file all-lists.txt)"
    if [ ! -s "$ALL_LIST_CACHE" ]; then
        for f in "$LISTS_DIR"/*.txt; do
            [ -f "$f" ] || continue
            read_preset "$f"
        done | sort -u > "$ALL_LIST_CACHE"
    fi
    grep -Fxq "$pkg" "$ALL_LIST_CACHE"
}

# Comentário pt-BR que acompanha o pacote nos presets (vazio se não houver).
package_label() {
    local pkg="$1" labels
    labels="$(work_file labels.tsv)"
    if [ ! -s "$labels" ]; then
        awk '
            /^[[:space:]]*#/ { next }
            /^[[:space:]]*$/ { next }
            {
                name = $0
                sub(/#.*/, "", name)
                sub(/^[[:space:]]+/, "", name)
                sub(/[[:space:]]+$/, "", name)
                if (name == "") next
                label = $0
                if (label !~ /#/) next
                sub(/^[^#]*#[[:space:]]*/, "", label)
                sub(/[[:space:]]+$/, "", label)
                if (label == "") next
                if (name in seen) next
                seen[name] = 1
                printf "%s\t%s\n", name, label
            }
        ' "$LISTS_DIR"/*.txt > "$labels" 2>/dev/null
    fi
    awk -F'\t' -v p="$pkg" '$1 == p { print $2; exit }' "$labels" 2>/dev/null
}

# Imprime "  <marca> <pacote>  — <rótulo>" (rótulo é opcional).
print_pkg() {
    if [ -n "$3" ]; then
        printf '  %s %s  — %s\n' "$1" "$2" "$3"
    else
        printf '  %s %s\n' "$1" "$2"
    fi
}

# ---------------------------------------------------------------------------
# tweaks (equivalente ao Tweaks.bat, mas com verificação e reset exato)
# ---------------------------------------------------------------------------

# Devolve o valor atual de um global setting. Vazio = chave inexistente/null.
tweak_get() {
    local v
    v="$(sh_run settings get global "$1" | head -n 1)"
    case "$v" in
        ''|null|Null|NULL) printf '' ;;
        *) printf '%s' "$v" ;;
    esac
}

# Guarda o valor original só na primeira vez (primeiro write ganha).
tweak_record() {
    local key="$1" old="${2:-}"
    mkdir -p "$DATA_DIR" || return 0
    if [ -f "$TWEAKS_FILE" ] && \
       awk -F'\t' -v k="$key" '$1==k{found=1} END{exit !found}' "$TWEAKS_FILE"; then
        return 0
    fi
    printf '%s\t%s\n' "$key" "$old" >> "$TWEAKS_FILE"
}

tweak_forget() {
    local key="$1" tmp
    [ -f "$TWEAKS_FILE" ] || return 0
    tmp="${TWEAKS_FILE}.tmp.$$"
    awk -F'\t' -v k="$key" '$1!=k' "$TWEAKS_FILE" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$TWEAKS_FILE"
}

# Aplica um setting e confere se o firmware aceitou.
tweak_apply() {
    local key="$1" value="$2" desc="${3:-}" optional="${4:-}" cur now
    cur="$(tweak_get "$key")"

    if [ -n "$optional" ] && [ -z "$cur" ]; then
        dim "$(m tweak_apply_01 "$key")"
        TW_SKIPPED=$((TW_SKIPPED + 1))
        return 0
    fi

    if [ "$cur" = "$value" ]; then
        dim "$(m tweak_apply_02 "$key" "$value")"
        TW_SAME=$((TW_SAME + 1))
        return 0
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        say "$(m tweak_apply_03 "$key" "${cur:-null}" "$value")"
        [ -n "$desc" ] && dim "      $desc"
        TW_CHANGED=$((TW_CHANGED + 1))
        return 0
    fi

    tweak_record "$key" "$cur"
    sh_run settings put global "$key" "$value" >/dev/null
    now="$(tweak_get "$key")"

    if [ "$now" = "$value" ]; then
        ok "$(m tweak_apply_04 "$key" "$value")"
        [ -n "$desc" ] && dim "      $desc"
        TW_CHANGED=$((TW_CHANGED + 1))
    else
        warn "$(m tweak_apply_05 "$key" "$value" "${now:-null}")"
        TW_IGNORED=$((TW_IGNORED + 1))
    fi
}

# Remove uma chave (volta ao default do sistema).
tweak_clear() {
    local key="$1" cur now
    cur="$(tweak_get "$key")"
    if [ -z "$cur" ]; then
        dim "$(m tweak_clear_01 "$key")"
        TW_SAME=$((TW_SAME + 1))
        return 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        say "$(m tweak_clear_02 "$key" "${cur}")"
        TW_CHANGED=$((TW_CHANGED + 1))
        return 0
    fi
    tweak_record "$key" "$cur"
    sh_run settings delete global "$key" >/dev/null 2>&1
    now="$(tweak_get "$key")"
    if [ -z "$now" ]; then
        ok "$(m tweak_clear_03 "$key")"
        TW_CHANGED=$((TW_CHANGED + 1))
    else
        warn "$(m tweak_clear_04 "$key" "${now}")"
        TW_IGNORED=$((TW_IGNORED + 1))
    fi
}

# Ações em pacotes (GOS) registradas no mesmo arquivo, com prefixo pkg:
tweak_record_pkg() {
    local pkg="$1"
    mkdir -p "$DATA_DIR" || return 0
    if [ -f "$TWEAKS_FILE" ] && \
       awk -F'\t' -v k="pkg:$pkg" '$1==k{found=1} END{exit !found}' "$TWEAKS_FILE"; then
        return 0
    fi
    printf 'pkg:%s\t0\n' "$pkg" >> "$TWEAKS_FILE"
}

tweak_disable_pkg() {
    local pkg="$1" desc="${2:-}" out
    if sh_run pm list packages -d --user 0 | sed -n 's/^package://p' | grep -Fxq "$pkg"; then
        dim "$(m tweak_disable_pkg_01 "$pkg")"
        TW_SAME=$((TW_SAME + 1))
        return 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        say "$(m tweak_disable_pkg_02 "$pkg")"
        [ -n "$desc" ] && dim "      $desc"
        TW_CHANGED=$((TW_CHANGED + 1))
        return 0
    fi
    tweak_record_pkg "$pkg"
    out="$(sh_run pm disable-user --user 0 "$pkg")"
    case "$out" in
        *disabled*|*Success*)
            ok "$(m tweak_disable_pkg_03 "$pkg")"
            [ -n "$desc" ] && dim "      $desc"
            TW_CHANGED=$((TW_CHANGED + 1))
            ;;
        *)
            warn "$(m tweak_disable_pkg_04 "$pkg" "$out")"
            TW_IGNORED=$((TW_IGNORED + 1))
            ;;
    esac
}

tweak_enable_pkg() {
    local pkg="$1" out
    out="$(sh_run pm enable "$pkg")"
    case "$out" in
        *enabled*|*Success*)
            ok "$(m tweak_enable_pkg_01 "$pkg")"
            tweak_forget "pkg:$pkg"
            return 0
            ;;
        *)
            err "$(m tweak_enable_pkg_02 "$pkg" "$out")"
            return 1
            ;;
    esac
}

cmd_tweaks_status() {
    step "$(m tweaks_status_01)"
    if [ ! -s "$TWEAKS_FILE" ]; then
        say "$(m tweaks_status_02 "$TWEAKS_FILE")"
        return 0
    fi
    while IFS="$(printf '\t')" read -r key old || [ -n "$key" ]; do
        case "$key" in
            pkg:*) say "$(m status_pkg_row "${key#pkg:}")" ;;
            *)     say "$(m status_setting_row "$key" "${old:-(null)}")" ;;
        esac
    done < "$TWEAKS_FILE"
    say ""
    dim "$(m tweaks_status_03)"
}

cmd_tweaks_reset() {
    local key old now total=0 changed=0 failed=0
    if [ ! -s "$TWEAKS_FILE" ]; then
        ok "$(m tweaks_reset_01)"
        say ""
        dim "$(m tweaks_reset_02)"
        dim "$(m tweaks_reset_03)"
        return 0
    fi

    step "$(m tweaks_reset_04)"
    while IFS="$(printf '\t')" read -r key old || [ -n "$key" ]; do
        [ -z "$key" ] && continue
        total=$((total + 1))
        if [ "$DRY_RUN" -eq 1 ]; then
            case "$key" in
                pkg:*) say "  ~ $(m reset_reenable "${key#pkg:}")" ;;
                *)     say "$(m reset_line "$key" "${old:-(null)}")" ;;
            esac
            changed=$((changed + 1))
            continue
        fi
        case "$key" in
            pkg:*)
                if tweak_enable_pkg "${key#pkg:}"; then
                    changed=$((changed + 1))
                else
                    failed=$((failed + 1))
                fi
                continue
                ;;
        esac
        if [ -z "$old" ]; then
            sh_run settings delete global "$key" >/dev/null 2>&1
        else
            sh_run settings put global "$key" "$old" >/dev/null
        fi
        now="$(tweak_get "$key")"
        if [ "$now" = "$old" ]; then
            ok "$(m tweaks_reset_05 "$key" "${old:-(padrão)}")"
            tweak_forget "$key"
            changed=$((changed + 1))
        else
            err "$(m tweaks_reset_06 "$key" "${old:-(padrão)}" "${now:-null}")"
            failed=$((failed + 1))
        fi
    done < "$TWEAKS_FILE"

    say ""
    say "$(m tweaks_reset_07 "$changed" "$total")"
    [ "$failed" -gt 0 ] && err "$(m restore_failed "$failed")"
    [ "$DRY_RUN" -eq 0 ] && [ "$failed" -eq 0 ] && : > "$TWEAKS_FILE"
    return 0
}

# Valores que o Tweaks.bat original aplicava e que continuam fazendo sentido.
cmd_tweaks_apply() {
    say ""
    say "$(m tweaks_apply_01)"
    say "$(m tweaks_apply_02)"
    step "$(m tweaks_apply_03)"
    tweak_apply window_animation_scale 0.5 "$(m twdesc_anim05)"
    tweak_apply transition_animation_scale 0.5
    tweak_apply animator_duration_scale 0.5
    tweak_apply cached_apps_freezer enabled "$(m twdesc_freezer)" optional
    tweak_apply adaptive_battery_management_enabled 1 "$(m twdesc_adaptive)" optional
    tweak_apply send_action_app_error 0 "$(m twdesc_anrdialog)" optional

    step "$(m tweaks_apply_04)"
    tweak_apply wifi_scan_always_enabled 0 "$(m twdesc_wifiscan)"
    tweak_apply bluetooth_scan_always_enabled 0 "$(m twdesc_btscan)" optional

    say ""
    if [ "$DRY_RUN" -eq 1 ]; then
        say "$(m tweaks_apply_05)"
    else
        say "$(m tweaks_apply_06 "$TW_CHANGED" "$TW_SAME" "$TW_IGNORED" "$TW_SKIPPED")"
        say ""
        dim "$(m tweaks_apply_07)"
        dim "$(m tweaks_apply_08)"
    fi
}

# Modo performance: o miolo "agressivo" do Tweaks.bat original.
cmd_tweaks_performance() {
    local resp

    warn "$(m tweaks_performance_01)"
    warn "$(m tweaks_performance_02)"
    warn "$(m tweaks_performance_03)"
    if [ "$DRY_RUN" -eq 0 ] && [ "$ASSUME_YES" -eq 0 ]; then
        printf '%s' "$(m tweaks_perf_confirm)"
        read -r resp
        case "$resp" in
            s|S|sim|SIM|y|Y) ;;
            *) say "$(m cancelled2)"; return 0 ;;
        esac
    fi

    step "$(m tweaks_performance_04)"
    tweak_apply window_animation_scale 0.35 "$(m twdesc_anim035)"
    tweak_apply transition_animation_scale 0.35
