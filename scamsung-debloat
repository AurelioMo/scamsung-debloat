#!/usr/bin/env bash
#
# scamsung-debloat — tira bloatware de Galaxy sem root.
#
# Reescrita do debloat_samsung_android (invinciblevenom), que era .bat, parou na
# One UI 6.1 e foi arquivado. Esta aqui roda em macOS, Linux e Windows (Git Bash),
# funciona na One UI 8/9 e só mexe no que existe no seu aparelho:
#   - lista pacotes do próprio aparelho e ignora o que não está lá
#   - deny-list embutida: pacotes críticos nunca saem
#   - se o uninstall falhar no seu firmware, tenta desativar no lugar
#   - antes de remover qualquer coisa, mostra tudo e pede "sim"
#   - guarda o que fez e volta atrás com `./scamsung-debloat restore`
#   - tweaks do Tweaks.bat original, com verificação e reset exato
#
set -o pipefail

APP_NAME="scamsung-debloat"
APP_VERSION="1.6.0"

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LISTS_DIR="$ROOT_DIR/lists"
DATA_DIR="${SCAMSUNG_DEBLOAT_DATA_DIR:-$HOME/.local/share/scamsung-debloat}"
STATE_FILE="$DATA_DIR/state.tsv"
TWEAKS_FILE="$DATA_DIR/tweaks.tsv"
LOG_DIR="$DATA_DIR/logs"

METHOD="uninstall"
DRY_RUN=0
ASSUME_YES=0
VERBOSE=0
SERIAL="${ANDROID_SERIAL:-}"
ONLY=""
SKIP=""
QUIET=0

ADB=""
SESSION_LOG=""
WORK_DIR=""
PKG_INSTALLED=""
PKG_KNOWN=""
ALL_LIST_CACHE=""
TARGET_FILE=""
FILTERED_FILE=""
TARGET_LABEL=""

# ---------------------------------------------------------------------------
# cores / log
# ---------------------------------------------------------------------------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    C_RESET="$(tput sgr0 2>/dev/null || true)"
    C_BOLD="$(tput bold 2>/dev/null || true)"
    C_DIM="$(tput dim 2>/dev/null || true)"
    C_RED="$(tput setaf 1 2>/dev/null || true)"
    C_GREEN="$(tput setaf 2 2>/dev/null || true)"
    C_YELLOW="$(tput setaf 3 2>/dev/null || true)"
    C_BLUE="$(tput setaf 4 2>/dev/null || true)"
    C_CYAN="$(tput setaf 6 2>/dev/null || true)"
else
    C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_GREEN=""
    C_YELLOW=""; C_BLUE=""; C_CYAN=""
fi

say()  { [ "$QUIET" -eq 1 ] || printf '%s\n' "$*"; }
ok()   { [ "$QUIET" -eq 1 ] || printf '%s%s%s\n' "$C_GREEN" "$*" "$C_RESET"; }
warn() { [ "$QUIET" -eq 1 ] || printf '%s%s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2; }
err()  { printf '%s%s%s\n' "$C_RED" "$*" "$C_RESET" >&2; }
step() { [ "$QUIET" -eq 1 ] || printf '\n%s==> %s%s\n' "$C_BOLD$C_CYAN" "$*" "$C_RESET"; }
dim()  { [ "$QUIET" -eq 1 ] || printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }

die() { err "erro: $*"; exit 1; }

cleanup() {
    [ -n "$WORK_DIR" ] && [ -d "$WORK_DIR" ] && rm -rf "$WORK_DIR"
}
trap cleanup EXIT INT TERM

init_work_dir() {
    WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/scamsung-debloat.XXXXXX")" \
        || die "não consegui criar diretório temporário"
}

work_file() {
    # uso: pf="$(work_file installed)"  (o caminho é estável, não cria lixo)
    printf '%s/%s' "$WORK_DIR" "$1"
}

# ---------------------------------------------------------------------------
# ajuda
# ---------------------------------------------------------------------------

usage() {
    cat <<EOF
${C_BOLD}$APP_NAME $APP_VERSION${C_RESET} — tira bloatware de Galaxy sem root

USO
  ./scamsung-debloat                    menu interativo
  ./scamsung-debloat doctor             confere adb, aparelho e versão do Android/One UI
  ./scamsung-debloat list               mostra os presets
  ./scamsung-debloat apply <preset>     mostra tudo que vai sair e aplica se você confirmar
  ./scamsung-debloat explain <pacote>   o que é o pacote, em quais presets ele está
  ./scamsung-debloat scan [termo]       pacotes instalados que contêm o termo
  ./scamsung-debloat status             o que você já removeu por aqui
  ./scamsung-debloat restore            volta tudo que este script removeu
  ./scamsung-debloat tweaks             ajustes leves de sistema
  ./scamsung-debloat tweaks --performance   modo agressivo: GOS, RAM Plus, zram, térmico
  ./scamsung-debloat tweaks --status    o que os tweaks mudaram e o valor original
  ./scamsung-debloat tweaks --reset     desfaz só o que este script mudou
  ./scamsung-debloat tweaks --ram-plus off|on
  ./scamsung-debloat apply --only com.facebook.katana
  ./scamsung-debloat wireless           pareia por Wi-Fi em vez de cabo
  ./scamsung-debloat self-test          valida os presets (não precisa de aparelho)

OPÇÕES
  -y, --yes            pula a perguntinha (a prévia aparece de qualquer jeito)
      --disable        desativa em vez de desinstalar — mantém os dados do app
      --skip a,b       pula esses pacotes
      --serial SERIAL  qual aparelho usar quando tem mais de um
  -v, --verbose        mostra também o que já estava fora
  -q, --quiet          só erros
  -h, --help           esta ajuda

AMBIENTE
  ANDROID_SERIAL       mesma coisa que --serial
  SCAMSUNG_DEBLOAT_DATA_DIR      onde ficam estado e logs (padrão: ~/.local/share/scamsung-debloat)
  NO_COLOR=1           sem cores
EOF
}

# ---------------------------------------------------------------------------
# adb / aparelho
# ---------------------------------------------------------------------------

host_os() {
    case "$(uname -s 2>/dev/null)" in
        Darwin) printf 'macOS' ;;
        Linux)  printf 'Linux' ;;
        MINGW*|MSYS*|CYGWIN*) printf 'Windows (Git Bash)' ;;
        *)      printf 'desconhecido' ;;
    esac
}

install_hint() {
    case "$(uname -s 2>/dev/null)" in
        Darwin)
            say "  brew install --cask android-platform-tools"
            ;;
        Linux)
            say "  Debian/Ubuntu : sudo apt install android-tools-adb android-tools-fastboot"
            say "  Fedora        : sudo dnf install android-tools"
            say "  Arch          : sudo pacman -S android-tools"
            ;;
        MINGW*|MSYS*|CYGWIN*)
            say "  winget install --id Google.PlatformTools -e"
            say "  (ou baixe platform-tools e adicione a pasta ao PATH)"
            ;;
        *)
            say "  https://developer.android.com/tools/releases/platform-tools"
            ;;
    esac
}

find_adb() {
    local candidate
    if command -v adb >/dev/null 2>&1; then
        ADB="$(command -v adb)"
        return 0
    fi
    for candidate in \
        /opt/homebrew/bin/adb \
        /usr/local/bin/adb \
        /usr/bin/adb \
        /snap/bin/adb \
        /opt/android-sdk/platform-tools/adb \
        "$HOME/Library/Android/sdk/platform-tools/adb" \
        "$HOME/Android/Sdk/platform-tools/adb" \
        "$HOME/Android/sdk/platform-tools/adb" \
        "${LOCALAPPDATA:-/nonexistent}/Android/Sdk/platform-tools/adb.exe" \
        "${LOCALAPPDATA:-/nonexistent}/Android/Sdk/platform-tools/adb" \
        "${USERPROFILE:-/nonexistent}/AppData/Local/Android/Sdk/platform-tools/adb.exe"
    do
        if [ -x "$candidate" ]; then
            ADB="$candidate"
            return 0
        fi
    done
    return 1
}

require_adb() {
    if ! find_adb; then
        err "adb não encontrado ($(host_os))."
        say ""
        say "Instale o platform-tools:"
        install_hint
        say ""
        say "Ou baixe em: https://developer.android.com/tools/releases/platform-tools"
        exit 1
    fi
}

adb_run() {
    if [ -n "$SERIAL" ]; then
        "$ADB" -s "$SERIAL" "$@"
    else
        "$ADB" "$@"
    fi
}

# saída de shell do aparelho, sem CR
sh_run() {
    adb_run shell "$@" 2>&1 | tr -d '\r'
}

getprop() {
    sh_run getprop "$1" | head -n 1
}

select_device() {
    local out state serial count
    # tr -d '\r': no Windows (Git Bash) o adb.exe responde com CRLF
    out="$("$ADB" devices 2>/dev/null | tr -d '\r' || true)"

    if printf '%s\n' "$out" | grep -q '^adb'; then
        # linhas de daemon ("* daemon started successfully") não contam
        :
    fi

    count="$(printf '%s\n' "$out" | awk 'NR>1 && NF==2 && $2!="" {c++} END {print c+0}')"

    if [ "$count" -eq 0 ]; then
        err "nenhum aparelho detectado pelo adb."
        say ""
        say "Checklist no celular:"
        say "  1. Configurações > Sobre o telefone > Informações do software"
        say "  2. Toque 7x em 'Número da versão' para habilitar Opções do desenvolvedor"
        say "  3. Configurações > Opções do desenvolvedor > Depuração USB: ligada"
        say "  4. Conecte o cabo e aceite 'Permitir depuração USB?' no celular"
        say "  5. No Mac, se aparecer o Android File Transfer, pode fechar"
        say ""
        say "Sem cabo? Rode: ./scamsung-debloat wireless"
        exit 1
    fi

    if [ -n "$SERIAL" ]; then
        state="$(printf '%s\n' "$out" | awk -v s="$SERIAL" 'NR>1 && $1==s {print $2}' | head -n 1)"
        [ -z "$state" ] && die "aparelho '$SERIAL' não está conectado."
        check_device_state "$SERIAL" "$state"
        return 0
    fi

    if [ "$count" -gt 1 ]; then
        err "há $count aparelhos conectados. Escolha um com --serial:"
        printf '%s\n' "$out" | awk 'NR>1 && NF==2 {printf "  %s (%s)\n", $1, $2}'
        exit 1
    fi

    serial="$(printf '%s\n' "$out" | awk 'NR>1 && NF==2 {print $1; exit}')"
    state="$(printf '%s\n' "$out" | awk 'NR>1 && NF==2 {print $2; exit}')"
    SERIAL="$serial"
    check_device_state "$SERIAL" "$state"
}

check_device_state() {
    local serial="$1" state="$2"
    case "$state" in
        device) ;;
        unauthorized)
            err "aparelho $serial está 'unauthorized'."
            say "Desbloqueie o celular e aceite o diálogo 'Permitir depuração USB?'."
            say "Se não aparecer: Opções do desenvolvedor > Revogar autorizações USB e reconecte."
            exit 1
            ;;
        offline)
            err "aparelho $serial está 'offline'."
            say "Reconecte o cabo, troque a porta USB ou rode: adb kill-server && adb devices"
            exit 1
            ;;
        *)
            err "aparelho $serial em estado inesperado: $state"
            exit 1
            ;;
    esac
}

load_device_info() {
    ANDROID_VER="$(getprop ro.build.version.release)"
    ONEUI_RAW="$(getprop ro.build.version.oneui)"
    SEM_RAW="$(getprop ro.build.version.sem)"
    MODEL="$(getprop ro.product.model)"
    DEVICE_CODE="$(getprop ro.product.device)"
    PDA="$(getprop ro.build.PDA)"
    [ -z "$MODEL" ] && MODEL="desconhecido"
    [ -z "$ANDROID_VER" ] && ANDROID_VER="desconhecido"

    ONEUI_LABEL=""
    ONEUI_MAJOR=0
    case "$ONEUI_RAW" in
        ''|*[!0-9]*) ;;
        *)
            ONEUI_MAJOR=$((ONEUI_RAW / 10000))
            ONEUI_MINOR=$(((ONEUI_RAW % 10000) / 100))
            ONEUI_LABEL="$ONEUI_MAJOR.$ONEUI_MINOR"
            ;;
    esac
    if [ -z "$ONEUI_LABEL" ]; then
        case "$SEM_RAW" in
            ''|*[!0-9]*) ONEUI_LABEL="desconhecida" ;;
            *)
                ONEUI_LABEL="sem=$SEM_RAW"
                ;;
        esac
    fi
}

print_device_header() {
    printf '%s%s%s\n' "$C_BOLD" "$MODEL ($DEVICE_CODE)" "$C_RESET"
    printf '  Android %s | One UI %s\n' "$ANDROID_VER" "$ONEUI_LABEL"
    [ -n "$PDA" ] && printf '  build %s\n' "$PDA"
    printf '  serial %s\n' "$SERIAL"

    if [ "$ONEUI_MAJOR" -gt 9 ] 2>/dev/null; then
        warn "  One UI $ONEUI_LABEL ainda não foi validada neste script."
        warn "  O modo seguro continua valendo: só pacotes instalados entram, e a deny-list é aplicada."
    fi
}

load_packages() {
    step "Lendo os pacotes do aparelho"
    PKG_INSTALLED="$(work_file installed.txt)"
    PKG_KNOWN="$(work_file known.txt)"

    sh_run pm list packages --user 0 \
        | sed -n 's/^package://p' \
        | sort -u > "$PKG_INSTALLED"

    sh_run pm list packages -u --user 0 \
        | sed -n 's/^package://p' \
        | sort -u > "$PKG_KNOWN"

    if [ ! -s "$PKG_KNOWN" ]; then
        err "não consegui listar pacotes. O aparelho está desbloqueado e autorizado?"
        exit 1
    fi

    dim "  $(wc -l < "$PKG_INSTALLED" | tr -d ' ') instalados agora / $(wc -l < "$PKG_KNOWN" | tr -d ' ') que o aparelho conhece"
}

is_installed() { grep -Fxq "$1" "$PKG_INSTALLED" 2>/dev/null; }
is_known()     { grep -Fxq "$1" "$PKG_KNOWN" 2>/dev/null; }

# ---------------------------------------------------------------------------
# política de segurança
# ---------------------------------------------------------------------------

# Pacotes que este script nunca toca, mesmo que apareçam numa lista.
is_denied() {
    case "$1" in
        android) return 0 ;;

        # Android / Google core
        com.google.android.gms|com.google.android.gms.*) return 0 ;;
        com.google.android.gsf|com.google.android.gsf.*) return 0 ;;
        com.android.vending|com.android.vending.*) return 0 ;;
        com.android.systemui|com.android.systemui.*) return 0 ;;
        com.android.settings|com.android.settings.*) return 0 ;;
        com.android.shell|com.android.shell.*) return 0 ;;
        com.android.permissioncontroller|com.android.permissioncontroller.*) return 0 ;;
        com.google.android.webview|com.android.webview) return 0 ;;
        com.android.phone|com.android.phone.*) return 0 ;;
        com.android.server.telecom|com.android.server.telecom.*) return 0 ;;
        com.android.providers.telephony|com.android.providers.telephony.*) return 0 ;;
        com.android.providers.contacts|com.android.providers.contacts.*) return 0 ;;
        com.android.providers.media|com.android.providers.media.*) return 0 ;;
        com.android.providers.downloads|com.android.providers.downloads.*) return 0 ;;
        com.android.documentsui|com.android.documentsui.*) return 0 ;;
        com.android.launcher3|com.android.launcher3.*) return 0 ;;
        com.android.inputmethod.latin) return 0 ;;

        # Samsung core / conectividade / boot
        com.samsung.android.SettingsReceiver) return 0 ;;
        com.samsung.android.incallui) return 0 ;;
        com.samsung.android.dialer) return 0 ;;
        com.samsung.android.communicationservice) return 0 ;;
        com.samsung.android.networkstack|com.samsung.android.networkstack.*) return 0 ;;
        com.samsung.android.wifi|com.samsung.android.wifi.*) return 0 ;;
        com.samsung.android.ConnectivityOverlay) return 0 ;;
        com.samsung.android.ConnectivityUxOverlay) return 0 ;;
        com.samsung.android.timezone|com.samsung.android.timezone.*) return 0 ;;
        com.samsung.networkui) return 0 ;;
        com.samsung.android.mtp) return 0 ;;
        com.samsung.android.storage.watchstoragemanager) return 0 ;;
        com.samsung.android.app.soundpicker) return 0 ;;
        com.samsung.android.applock) return 0 ;;
        com.samsung.android.clipboarduiservice) return 0 ;;
        com.sec.android.app.simsettingmgr) return 0 ;;
        com.samsung.android.honeyboard) return 0 ;;            # teclado Samsung
        com.samsung.android.app.launcher|com.sec.android.app.launcher) return 0 ;;  # One UI Home
        com.samsung.android.kgclient) return 0 ;;             # remove = overlay de bloqueio do aparelho
        com.samsung.android.sm.policy) return 0 ;;
        com.samsung.android.app.telephonyui) return 0 ;;
        com.samsung.android.ims|com.samsung.android.ims.*) return 0 ;;
        com.sec.ims|com.sec.ims.*) return 0 ;;
        com.sec.epdg|com.sec.epdg.*) return 0 ;;
        com.sec.unifiedwfc) return 0 ;;                        # Wi-Fi calling
        com.samsung.android.app.aodservice) return 0 ;;        # AOD + relógio da lockscreen

        # UAD-ng classifica como "Unsafe": remover quebra Settings/tela
        com.android.bips) return 0 ;;                          # print service: Settings crasha
        com.android.internal.display.cutout.emulation.*) return 0 ;;  # overlays do recorte de tela
    esac
    return 1
}

# ---------------------------------------------------------------------------
# listas
# ---------------------------------------------------------------------------

strip_line() {
    # remove comentário e espaços em volta
    printf '%s' "$1" | sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//'
}

list_presets() {
    local f
    for f in "$LISTS_DIR"/*.txt; do
        [ -f "$f" ] || continue
        basename "$f" .txt
    done
}

preset_path() {
    printf '%s/%s.txt' "$LISTS_DIR" "$1"
}

# Lê pacotes de um preset e imprime um por linha.
read_preset() {
    local path="$1" line pkg
    [ -f "$path" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        pkg="$(strip_line "$line")"
        [ -n "$pkg" ] && printf '%s\n' "$pkg"
    done < "$path"
}

# Monta TARGET_FILE a partir de --only ou do preset.
build_target_list() {
    local preset="$1" path out
    out="$(work_file target.txt)"
    : > "$out"

    if [ -n "$ONLY" ]; then
        printf '%s\n' "$ONLY" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
            | sed '/^$/d' > "$out"
        TARGET_LABEL="custom (--only)"
        TARGET_FILE="$out"
        return 0
    fi

    path="$(preset_path "$preset")"
    [ -f "$path" ] || return 1
    read_preset "$path" > "$out" || true
    TARGET_LABEL="preset $preset"
    TARGET_FILE="$out"
    return 0
}

# Aplica --skip e devolve o caminho final em FILTERED_FILE.
filter_skip() {
    local out="$1" skipfile filtered
    filtered="$(work_file filtered.txt)"
    if [ -z "$SKIP" ]; then
        cp "$out" "$filtered"
        FILTERED_FILE="$filtered"
        return 0
    fi
    skipfile="$(work_file skip.txt)"
    printf '%s\n' "$SKIP" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
        | sed '/^$/d' | sort -u > "$skipfile"
    if [ -s "$out" ]; then
        grep -F -x -v -f "$skipfile" "$out" > "$filtered" || true
    else
        : > "$filtered"
    fi
    FILTERED_FILE="$filtered"
    return 0
}

# ---------------------------------------------------------------------------
# ações
# ---------------------------------------------------------------------------

ensure_session_log() {
    [ -n "$SESSION_LOG" ] && return 0
    mkdir -p "$LOG_DIR" || die "não consegui criar $LOG_DIR"
    SESSION_LOG="$LOG_DIR/session-$(date +%Y%m%d-%H%M%S).tsv"
    printf 'epoch\taction\tpackage\tcontext\n' >> "$SESSION_LOG"
}

record_action() {
    local pkg="$1" action="$2" context="$3" tmp
    ensure_session_log
    printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$action" "$pkg" "$context" >> "$SESSION_LOG"

    mkdir -p "$DATA_DIR" || return 0
    tmp="${STATE_FILE}.tmp.$$"
    if [ -f "$STATE_FILE" ]; then
        awk -F'\t' -v p="$pkg" '$2 != p' "$STATE_FILE" > "$tmp" 2>/dev/null || true
    else
        : > "$tmp"
    fi
    printf '%s\t%s\n' "$action" "$pkg" >> "$tmp"
    mv "$tmp" "$STATE_FILE"
}

apply_one() {
    local pkg="$1" context="$2" out action label
    if is_denied "$pkg"; then
        warn "  ! $pkg  (bloqueado pela política de segurança)"
        BLOCKED=$((BLOCKED + 1))
        return 0
    fi
    case "$pkg" in
        *[!A-Za-z0-9._]*|'') err "  x nome inválido: $pkg"; FAILED=$((FAILED + 1)); return 0 ;;
    esac
    if ! is_known "$pkg"; then
        MISSING=$((MISSING + 1))
        [ "$VERBOSE" -eq 1 ] && dim "  - $pkg  (não existe neste aparelho)"
        return 0
    fi
    if ! is_installed "$pkg"; then
        ALREADY=$((ALREADY + 1))
        [ "$VERBOSE" -eq 1 ] && dim "  . $pkg  (já removido)"
        return 0
    fi
    label="$(package_label "$pkg")"
    if [ "$DRY_RUN" -eq 1 ]; then
        print_pkg "~" "$pkg" "$label"
        WILL=$((WILL + 1))
        return 0
    fi

    if [ "$METHOD" = "disable" ]; then
        out="$(sh_run pm disable-user --user 0 "$pkg")"
        case "$out" in
            *disabled*) action="DISABLED" ;;
            *) action="FAILED" ;;
        esac
    else
        out="$(sh_run pm uninstall --user 0 "$pkg")"
        case "$out" in
            *Success*)
                action="REMOVED"
                ;;
            *"not installed for"*)
                action="SKIPPED"
                ;;
            *)
                # firmware novo pode bloquear uninstall de app de sistema:
                # cai para disable, que é reversível e mantém os dados.
                out="$(sh_run pm disable-user --user 0 "$pkg")"
                case "$out" in
                    *disabled*) action="DISABLED" ;;
                    *) action="FAILED" ;;
                esac
                ;;
        esac
    fi

    case "$action" in
        REMOVED)
            ok "  + $pkg${label:+  — $label}"
            REMOVED=$((REMOVED + 1))
            record_action "$pkg" "REMOVED" "$context"
            ;;
        DISABLED)
            ok "  + $pkg  (desativado)${label:+  — $label}"
            DISABLED=$((DISABLED + 1))
            record_action "$pkg" "DISABLED" "$context"
            ;;
        SKIPPED)
            ALREADY=$((ALREADY + 1))
            [ "$VERBOSE" -eq 1 ] && dim "  . $pkg  (já removido)"
            ;;
        *)
            err "  x $pkg  ($out)"
            FAILED=$((FAILED + 1))
            ;;
    esac
}

cmd_apply() {
    local preset="${1:-}" pkg total
    if [ -z "$preset" ] && [ -z "$ONLY" ]; then
        err "informe um preset ou --only."
        say "Presets: $(list_presets | tr '\n' ' ')"
        exit 1
    fi
    if [ -n "$preset" ] && [ -z "$ONLY" ] && [ ! -f "$(preset_path "$preset")" ]; then
        err "preset '$preset' não existe."
        say "Presets: $(list_presets | tr '\n' ' ')"
        exit 1
    fi

    require_adb
    select_device
    load_device_info
    say ""
    print_device_header
    say ""

    build_target_list "$preset" || exit 1
    filter_skip "$TARGET_FILE"
    sort -u "$FILTERED_FILE" -o "$FILTERED_FILE" 2>/dev/null || true
    total="$(wc -l < "$FILTERED_FILE" | tr -d ' ')"

    if [ "$total" -eq 0 ]; then
        warn "lista vazia: nada a fazer."
        exit 0
    fi

    load_packages

    REMOVED=0; DISABLED=0; ALREADY=0; MISSING=0; FAILED=0; BLOCKED=0; WILL=0

    step "Prévia: $TARGET_LABEL"
    say "  método: $([ "$METHOD" = disable ] && echo 'desativar' || echo 'desinstalar para o usuário 0')"
    say "  $total pacotes na lista"
    say ""

    # prévia é obrigatória: primeiro o que iria, depois confirma e só então aplica
    DRY_RUN=1
    while IFS= read -r pkg; do
        [ -z "$pkg" ] && continue
        apply_one "$pkg" "$TARGET_LABEL"
    done < "$FILTERED_FILE"
    DRY_RUN=0

    say ""
    say "  remover:              $WILL"
    say "  já removidos antes:   $ALREADY"
    say "  ausentes no aparelho: $MISSING (ignorados)"
    [ "$BLOCKED" -gt 0 ] && warn "  bloqueados pela política: $BLOCKED"

    if [ "$WILL" -eq 0 ]; then
        say ""
        say "nada a fazer."
        exit 0
    fi

    if [ "$ASSUME_YES" -ne 1 ]; then
        say ""
        say "Isso remove apps do seu usuário. Dá para reverter com: ./scamsung-debloat restore"
        printf 'Digite %ssim%s para continuar: ' "$C_BOLD" "$C_RESET"
        read -r answer
        case "$answer" in
            sim|SIM|Sim|s|S|y|Y|yes|YES) ;;
            *) warn "cancelado."; exit 0 ;;
        esac
    fi

    REMOVED=0; DISABLED=0; ALREADY=0; MISSING=0; FAILED=0; BLOCKED=0
    step "Aplicando ($TARGET_LABEL)"
    while IFS= read -r pkg; do
        [ -z "$pkg" ] && continue
        apply_one "$pkg" "$TARGET_LABEL"
    done < "$FILTERED_FILE"

    say ""
    step "Resumo"
    say "  removidos:             $REMOVED"
    say "  desativados:           $DISABLED"
    say "  já removidos antes:    $ALREADY"
    say "  ausentes no aparelho:  $MISSING"
    [ "$BLOCKED" -gt 0 ] && warn "  bloqueados pela política: $BLOCKED"
    [ "$FAILED" -gt 0 ] && err "  falharam: $FAILED"

    if [ $((REMOVED + DISABLED)) -gt 0 ]; then
        say ""
        say "Log: $SESSION_LOG"
        say "Reverter: ./scamsung-debloat restore"
        say "Recomendado reiniciar o aparelho depois de aplicar."
    fi
}

cmd_restore() {
    require_adb
    select_device
    load_device_info
    say ""
    print_device_header

    if [ ! -s "$STATE_FILE" ]; then
        ok "nada para restaurar (estado vazio em $STATE_FILE)."
        return 0
    fi

    local total action pkg out done_count failed_count
    total="$(wc -l < "$STATE_FILE" | tr -d ' ')"
    step "Restaurando $total pacote(s)"

    if [ "$ASSUME_YES" -ne 1 ] && [ "$DRY_RUN" -ne 1 ]; then
        printf 'Digite %ssim%s para restaurar: ' "$C_BOLD" "$C_RESET"
        read -r answer
        case "$answer" in
            sim|SIM|Sim|s|S|y|Y|yes|YES) ;;
            *) warn "cancelado."; exit 0 ;;
        esac
    fi

    tmp="${STATE_FILE}.restore.$$"
    : > "$tmp"
    done_count=0
    failed_count=0

    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        action="$(printf '%s' "$line" | cut -f1)"
        pkg="$(printf '%s' "$line" | cut -f2)"
        [ -z "$pkg" ] && continue

        case "$action" in
            REMOVED)
                if [ "$DRY_RUN" -eq 1 ]; then
                    printf '  ~ reinstalar %s\n' "$pkg"
                    done_count=$((done_count + 1))
                    continue
                fi
                out="$(sh_run cmd package install-existing --user 0 "$pkg")"
                case "$out" in
                    *installed*|*Success*)
                        ok "  + $pkg"
                        done_count=$((done_count + 1))
                        ;;
                    *)
                        err "  x $pkg ($out)"
                        failed_count=$((failed_count + 1))
                        printf '%s\n' "$line" >> "$tmp"
                        ;;
                esac
                ;;
            DISABLED)
                if [ "$DRY_RUN" -eq 1 ]; then
                    printf '  ~ reativar %s\n' "$pkg"
                    done_count=$((done_count + 1))
                    continue
                fi
                out="$(sh_run pm enable "$pkg")"
                case "$out" in
                    *enabled*|*Success*)
                        ok "  + $pkg"
                        done_count=$((done_count + 1))
                        ;;
                    *)
                        err "  x $pkg ($out)"
                        failed_count=$((failed_count + 1))
                        printf '%s\n' "$line" >> "$tmp"
                        ;;
                esac
                ;;
            *)
                printf '%s\n' "$line" >> "$tmp"
                ;;
        esac
    done < "$STATE_FILE"

    if [ "$DRY_RUN" -ne 1 ]; then
        mv "$tmp" "$STATE_FILE"
        say ""
        say "  restaurados: $done_count"
        [ "$failed_count" -gt 0 ] && err "  falharam: $failed_count"
        say "Reinicie o aparelho para normalizar os apps restaurados."
    else
        rm -f "$tmp"
    fi
}

