}

cmd_tweaks() {
    local sub="${1:-}" extra="${2:-}"
    TW_CHANGED=0; TW_SAME=0; TW_IGNORED=0; TW_SKIPPED=0

    case "$sub" in
        --status|status)
            cmd_tweaks_status
            return 0
            ;;
        --defaults)
            # limpa só o registro local, sem tocar no aparelho
            if [ -f "$TWEAKS_FILE" ]; then
                : > "$TWEAKS_FILE"
                ok "  registro local de tweaks limpo."
            else
                dim "  nada para limpar."
            fi
            return 0
            ;;
    esac

    require_adb
    select_device
    load_device_info
    say ""
    print_device_header

    case "$sub" in
        ''|apply)
            cmd_tweaks_apply
            ;;
        --reset|reset)
            cmd_tweaks_reset
            ;;
        --ram-plus|ram-plus)
            cmd_tweaks_ram_plus "$extra" || return 1
            ;;
        --performance|performance|--full|full)
            cmd_tweaks_performance
            ;;
        *)
            err "não conheço esse modo de tweaks: $sub"
            say ""
            say "  ./scamsung-debloat tweaks                 conjunto leve (animações, bateria, varredura)"
            say "  ./scamsung-debloat tweaks --performance   GOS off, RAM Plus/zram off, térmico de jogos off"
            say "  ./scamsung-debloat tweaks --status        o que já foi mudado e o valor original"
            say "  ./scamsung-debloat tweaks --reset         devolve exatamente o que este script mudou"
            say "  ./scamsung-debloat tweaks --ram-plus off  liga/desliga só a RAM Plus"
            return 1
            ;;
    esac

    say ""
    dim "  nenhum ajuste mexe em root, Knox ou partições."
}

cmd_wireless() {
    require_adb
    say ""
    say "No celular: Configurações > Opções do desenvolvedor > Depuração sem fio"
    say "Toque em 'Emparelhar dispositivo com código' e copie IP:porta + código."
    say ""
    printf 'IP:porta de emparelhamento (ex. 192.168.0.12:37123): '
    read -r pair_addr
    printf 'Código de 6 dígitos: '
    read -r pair_code
    [ -z "$pair_addr" ] || [ -z "$pair_code" ] && die "dados de emparelhamento incompletos."

    "$ADB" pair "$pair_addr" "$pair_code" || warn "pareamento retornou erro; se o celular mostrar 'conectado', siga."

    say ""
    printf 'IP:porta de conexão (ex. 192.168.0.12:41234): '
    read -r conn_addr
    [ -z "$conn_addr" ] && die "endereço de conexão vazio."

    "$ADB" connect "$conn_addr"
    say ""
    "$ADB" devices | tr -d '\r'
}

cmd_self_test() {
    local errors=0 warnings=0 f preset line pkg lineno dup missing next
    step "Validando presets"

    if [ ! -d "$LISTS_DIR" ]; then
        err "  pasta não encontrada: $LISTS_DIR"
        return 1
    fi

    for f in "$LISTS_DIR"/*.txt; do
        [ -f "$f" ] || continue
        preset="$(basename "$f" .txt)"
        lineno=0
        while IFS= read -r line || [ -n "$line" ]; do
            lineno=$((lineno + 1))
            case "$line" in
                ''|'#'*) continue ;;
            esac
            pkg="$(strip_line "$line")"
            [ -z "$pkg" ] && continue
            case "$line" in
                *'#'*) ;;
                *)
                    err "  $preset:$lineno sem explicação (falta '# ...')"
                    errors=$((errors + 1))
                    ;;
            esac
            case "$pkg" in
                *[!A-Za-z0-9._]*)
                    err "  nome inválido em $preset:$lineno: $pkg"
                    errors=$((errors + 1))
                    continue
                    ;;
            esac
            if ! printf '%s' "$pkg" | grep -Eq '^[A-Za-z0-9_]+(\.[A-Za-z0-9_]+)+$'; then
                err "  nome fora do padrão em $preset:$lineno: $pkg"
                errors=$((errors + 1))
            fi
            if is_denied "$pkg"; then
                err "  pacote protegido em $preset: $pkg"
                errors=$((errors + 1))
            fi
        done < "$f"

        dup="$(read_preset "$f" | sort | uniq -d)"
        if [ -n "$dup" ]; then
            while IFS= read -r pkg; do
                [ -z "$pkg" ] && continue
                err "  duplicado em $preset: $pkg"
                errors=$((errors + 1))
            done <<EOF
$dup
EOF
        fi
    done

    for preset in basic light heavy; do
        if [ ! -f "$(preset_path "$preset")" ]; then
            err "  preset ausente: lists/$preset.txt"
            errors=$((errors + 1))
        fi
    done

    # heavy contém light, light contém basic
    local nest_a nest_b
    for preset in basic light; do
        case "$preset" in
            basic) next="light" ;;
            light) next="heavy" ;;
        esac
        [ -f "$(preset_path "$preset")" ] || continue
        [ -f "$(preset_path "$next")" ] || continue
        nest_a="$(work_file nest-small.txt)"
        nest_b="$(work_file nest-big.txt)"
        read_preset "$(preset_path "$preset")" | sort -u > "$nest_a"
        read_preset "$(preset_path "$next")" | sort -u > "$nest_b"
        missing="$(comm -23 "$nest_a" "$nest_b")"
        if [ -n "$missing" ]; then
            while IFS= read -r pkg; do
                [ -z "$pkg" ] && continue
                err "  $pkg está em $preset mas não em $next"
                errors=$((errors + 1))
            done <<EOF
$missing
EOF
        fi
    done

    say ""
    if [ "$errors" -eq 0 ]; then
        [ "$warnings" -gt 0 ] && warn "$warnings aviso(s) acima."
        ok "presets ok"
        return 0
    fi
    err "$errors erro(s), $warnings aviso(s) — corrija e rode ./scamsung-debloat self-test de novo"
    return 1
}

