        say "$(m status_02 "${C_YELLOW}" "${C_RESET}" "$(grep -c . "$STATE_FILE" | tr -d ' ')")"
        awk -F'\t' '{printf "    %-9s %s\n", $1, $2}' "$STATE_FILE"
