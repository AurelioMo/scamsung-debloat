menu() {
    local choice p tt
    while true; do
        say ""
        print_logo
        printf '  1) %s\n' "$(m menu_opt1)"
        printf '  2) %s\n' "$(m menu_opt2)"
        printf '  3) %s\n' "$(m menu_opt3)"
        printf '  4) %s\n' "$(m menu_opt4)"
        printf '  5) %s\n' "$(m menu_opt5)"
        printf '  6) %s\n' "$(m menu_opt6)"
        printf '  7) %s\n' "$(m menu_opt7)"
        printf '  8) %s\n' "$(m menu_opt8)"
        printf '%s' "$(m menu_choose)"
        read -r choice
        case "$choice" in
            1) cmd_doctor ;;
            2)
                printf '\n%s\n' "$(m menu_presets_line "$(list_presets | tr '\n' ' ')")"
                printf '%s' "$(m menu_which_preset)"
                read -r p
                [ -n "$p" ] && cmd_apply "$p"
                ;;
            3) cmd_status ;;
            4) cmd_restore ;;
            5)
                say ""
                say "$(m menu_tw_intro)"
                say ""
                printf '%s\n' "$(m menu_tw_p1)"
                printf '%s\n' "$(m menu_tw_p2)"
                printf '%s\n' "$(m menu_tw_p3)"
                printf '%s\n' "$(m menu_tw_p4)"
                printf '%s\n' "$(m menu_tw_p5)"
                printf '%s\n' "$(m menu_tw_p6)"
                say ""
                printf '%s\n' "$(m menu_tw_a1)"
                printf '%s\n' "$(m menu_tw_a2)"
                printf '%s\n' "$(m menu_tw_a3)"
                printf '%s\n' "$(m menu_tw_a4)"
                printf '%s\n' "$(m menu_tw_a5)"
                say ""
                printf '%s\n' "$(m menu_tw_s)"
                printf '%s\n' "$(m menu_tw_r)"
                say ""
                printf '%s' "$(m menu_tw_which)"
                read -r tt
                case "$tt" in
                    a|A) cmd_tweaks ;;
                    s|S) cmd_tweaks --status ;;
                    r|R) cmd_tweaks --reset ;;
                    ''|p|P) cmd_tweaks --performance ;;
                    *) warn "$(m menu_tw_invalid)" ;;
                esac
                ;;
            6)
                printf '%s' "$(m menu_scan_prompt)"
                read -r tt
                cmd_scan "$tt"
                ;;
            7) cmd_wireless ;;
            8|q|Q) exit 0 ;;
            '') ;;
            *) warn "$(m menu_invalid)" ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

suggest_cmd() {
    local g="$1" c out=""
    for c in menu doctor list apply explain scan status restore tweaks wireless self-test shell; do
        case "$c" in "$g"*) out="$out $c" ;; esac
    done
    printf '%s' "$out"
}

# contadores globais
REMOVED=0; DISABLED=0; ALREADY=0; MISSING=0; FAILED=0; BLOCKED=0; WILL=0
TARGET_LABEL=""

while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)     ASSUME_YES=1; shift ;;
        --disable)    METHOD="disable"; shift ;;
        --skip)       [ $# -ge 2 ] || die "$(m die_needs_skip)"; SKIP="$2"; shift 2 ;;
        --only)       [ $# -ge 2 ] || die "$(m die_needs_only)"; ONLY="$2"; shift 2 ;;
        -s|--serial)  [ $# -ge 2 ] || die "$(m die_needs_serial)"; SERIAL="$2"; shift 2 ;;
        -v|--verbose) VERBOSE=1; shift ;;
        -q|--quiet)   QUIET=1; shift ;;
        -h|--help)    usage; exit 0 ;;
        -V|--version) printf '%s %s\n' "$APP_NAME" "$APP_VERSION"; exit 0 ;;
        --)           shift; break ;;
        --categories) err "$(m err_no_categories)"; exit 1 ;;
        -*)           err "$(m err_bad_flag "$1")"; usage; exit 1 ;;
        *)            break ;;
    esac
done

CMD="${1:-menu}"
[ $# -gt 0 ] && shift

# opções também aceitas depois do subcomando (ex.: apply basic --dry-run)
if [ "$CMD" = "apply" ]; then
    ARGS=""
    while [ $# -gt 0 ]; do
        case "$1" in
                -y|--yes)     ASSUME_YES=1; shift ;;
            --disable)    METHOD="disable"; shift ;;
            --skip)       [ $# -ge 2 ] || die "$(m die_needs_skip)"; SKIP="$2"; shift 2 ;;
            --only)       [ $# -ge 2 ] || die "$(m die_needs_only)"; ONLY="$2"; shift 2 ;;
                -v|--verbose) VERBOSE=1; shift ;;
            -q|--quiet)   QUIET=1; shift ;;
            --categories) err "$(m err_no_categories)"; exit 1 ;;
            -*)           err "$(m err_bad_flag "$1")"; exit 1 ;;
            *)            ARGS="$ARGS $1"; shift ;;
        esac
    done
    set -- $ARGS
fi

init_work_dir

case "$CMD" in
    menu)      menu ;;
    doctor)    cmd_doctor ;;
    status)    cmd_status ;;
    list)      cmd_list ;;
    apply)     cmd_apply "${1:-}" ;;
    restore)   cmd_restore ;;
    scan)      cmd_scan "${1:-}" ;;
    explain)   cmd_explain "${1:-}" ;;
    tweaks)    cmd_tweaks "${1:-}" "${2:-}" ;;
    wireless)  cmd_wireless ;;
    self-test) cmd_self_test ;;
    help|-h|--help) usage ;;
    shell)
        require_adb
        select_device
        adb_run shell "$@"
        ;;
    *) err "$(m err_bad_cmd "$CMD")"
        sug="$(suggest_cmd "$CMD")"
        [ -n "$sug" ] && say "$(m did_you_mean)$sug"
        usage; exit 1 ;;
esac
