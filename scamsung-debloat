cmd_explain() {
    local pkg="${1:-}" f preset line label="" found=0 presets="" action o canon
    if [ -z "$pkg" ]; then
        err "uso: ./scamsung-debloat explain <pacote>"
        say "  exemplo: ./scamsung-debloat explain com.facebook.katana"
        return 1
    fi
    pkg="$(printf '%s' "$pkg" | sed 's/^package://')"

    say ""
    printf '%s%s%s\n' "$C_BOLD" "$pkg" "$C_RESET"

    for f in "$LISTS_DIR"/*.txt; do
        [ -f "$f" ] || continue
        line="$(grep -E "^[[:space:]]*$pkg([[:space:]]|$)" "$f" | head -n 1)"
        [ -z "$line" ] && continue
        found=1
        preset="$(basename "$f" .txt)"
        presets="$presets $preset"
        if [ -z "$label" ]; then
            label="$(printf '%s' "$line" | sed -n 's/^[^#]*#[[:space:]]*//p')"
        fi
    done

    [ -n "$label" ] && printf '  o que é : %s\n' "$label"
    if [ "$found" -eq 1 ]; then
        canon=""
        for o in basic light heavy; do
            case " $presets " in
                *" $o "*) canon="$canon $o" ;;
            esac
        done
        printf '  presets : %s\n' "$(printf '%s' "$canon" | sed 's/^ *//')"
    else
        dim "  não está em nenhum preset deste repositório."
    fi

    if is_denied "$pkg"; then
        printf '  deny-list : %sSIM — nunca é removido, nem com --only%s\n' "$C_RED" "$C_RESET"
    else
        printf '  deny-list : não\n'
    fi

    if [ -f "$STATE_FILE" ]; then
        action="$(awk -F'\t' -v p="$pkg" '$2==p{print $1; exit}' "$STATE_FILE" 2>/dev/null)"
        if [ -n "$action" ]; then
            printf '  estado    : %s (desfazer: ./scamsung-debloat restore)\n' "$action"
        fi
    fi

    if [ "$found" -eq 0 ] && ! is_denied "$pkg"; then
        say ""
        dim "  Não listado = o script não toca nele. Se for bloat do seu firmware,"
        dim "  adicione ao preset em lists/ e rode ./scamsung-debloat self-test."
    fi
    say ""
    return 0
}

list_contains() {
    local pkg="$1" f
    [ -z "$ALL_LIST_CACHE" ] && ALL_LIST_CACHE="$(work_file all-lists.txt)"
    if [ ! -s "$ALL_LIST_CACHE" ]; then
        for f in "$LISTS_DIR"/*.txt; do
            [ -f "$f" ] || continue
            read_preset "$f"
        done | sort -u > "$ALL_LIST_CACHE"
    fi
    grep -Fxq "$pkg" "$ALL_LIST_CACHE"
}

# Comentário pt-BR que acompanha o pacote nos presets (vazio se não houver).
package_label() {
    local pkg="$1" labels
    labels="$(work_file labels.tsv)"
    if [ ! -s "$labels" ]; then
        awk '
            /^[[:space:]]*#/ { next }
            /^[[:space:]]*$/ { next }
            {
                name = $0
                sub(/#.*/, "", name)
                sub(/^[[:space:]]+/, "", name)
                sub(/[[:space:]]+$/, "", name)
                if (name == "") next
                label = $0
                if (label !~ /#/) next
                sub(/^[^#]*#[[:space:]]*/, "", label)
                sub(/[[:space:]]+$/, "", label)
                if (label == "") next
                if (name in seen) next
                seen[name] = 1
                printf "%s\t%s\n", name, label
            }
        ' "$LISTS_DIR"/*.txt > "$labels" 2>/dev/null
    fi
    awk -F'\t' -v p="$pkg" '$1 == p { print $2; exit }' "$labels" 2>/dev/null
}

# Imprime "  <marca> <pacote>  — <rótulo>" (rótulo é opcional).
print_pkg() {
    if [ -n "$3" ]; then
        printf '  %s %s  — %s\n' "$1" "$2" "$3"
    else
        printf '  %s %s\n' "$1" "$2"
    fi
