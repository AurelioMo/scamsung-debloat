# ---------------------------------------------------------------------------
# adb / aparelho
# ---------------------------------------------------------------------------

host_os() {
    case "$(uname -s 2>/dev/null)" in
        Darwin) printf 'macOS' ;;
        Linux)  printf 'Linux' ;;
        MINGW*|MSYS*|CYGWIN*) printf 'Windows (Git Bash)' ;;
        *)      printf 'desconhecido' ;;
    esac
}

install_hint() {
    case "$(uname -s 2>/dev/null)" in
        Darwin)
            say "$(m install_hint_01)"
            ;;
        Linux)
            say "$(m install_hint_02)"
            say "$(m install_hint_03)"
            say "$(m install_hint_04)"
            ;;
        MINGW*|MSYS*|CYGWIN*)
            say "$(m install_hint_05)"
            say "$(m install_hint_06)"
            ;;
        *)
            say "$(m install_hint_07)"
            ;;
    esac
}

find_adb() {
    local candidate
    if command -v adb >/dev/null 2>&1; then
        ADB="$(command -v adb)"
        return 0
    fi
    for candidate in \
        /opt/homebrew/bin/adb \
        /usr/local/bin/adb \
        /usr/bin/adb \
        /snap/bin/adb \
        /opt/android-sdk/platform-tools/adb \
        "$HOME/Library/Android/sdk/platform-tools/adb" \
        "$HOME/Android/Sdk/platform-tools/adb" \
        "$HOME/Android/sdk/platform-tools/adb" \
        "${LOCALAPPDATA:-/nonexistent}/Android/Sdk/platform-tools/adb.exe" \
        "${LOCALAPPDATA:-/nonexistent}/Android/Sdk/platform-tools/adb" \
        "${USERPROFILE:-/nonexistent}/AppData/Local/Android/Sdk/platform-tools/adb.exe"
    do
        if [ -x "$candidate" ]; then
            ADB="$candidate"
            return 0
        fi
    done
    return 1
}

require_adb() {
    if ! find_adb; then
        err "$(m require_adb_01 "$(host_os)")"
        say ""
        say "$(m require_adb_02)"
        install_hint
        say ""
        say "$(m require_adb_03)"
        exit 1
    fi
}

adb_run() {
    if [ -n "$SERIAL" ]; then
        "$ADB" -s "$SERIAL" "$@"
    else
        "$ADB" "$@"
    fi
}

# saída de shell do aparelho, sem CR
sh_run() {
    adb_run shell "$@" 2>&1 | tr -d '\r'
}

getprop() {
    sh_run getprop "$1" | head -n 1
}

select_device() {
    local out state serial count
    # tr -d '\r': no Windows (Git Bash) o adb.exe responde com CRLF
    out="$("$ADB" devices 2>/dev/null | tr -d '\r' || true)"

    if printf '%s\n' "$out" | grep -q '^adb'; then
        # linhas de daemon ("* daemon started successfully") não contam
        :
    fi

    count="$(printf '%s\n' "$out" | awk 'NR>1 && NF==2 && $2!="" {c++} END {print c+0}')"

    if [ "$count" -eq 0 ]; then
        err "$(m select_device_01)"
        say ""
        say "$(m select_device_02)"
        say "$(m select_device_03)"
        say "$(m select_device_04)"
        say "$(m select_device_05)"
        say "$(m select_device_06)"
        say "$(m select_device_07)"
        say ""
        say "$(m select_device_08)"
        exit 1
    fi

    if [ -n "$SERIAL" ]; then
        state="$(printf '%s\n' "$out" | awk -v s="$SERIAL" 'NR>1 && $1==s {print $2}' | head -n 1)"
        [ -z "$state" ] && die "$(m die_not_connected "$SERIAL")"
        check_device_state "$SERIAL" "$state"
        return 0
    fi

    if [ "$count" -gt 1 ]; then
        err "$(m select_device_09 "$count")"
        printf '%s\n' "$out" | awk 'NR>1 && NF==2 {printf "  %s (%s)\n", $1, $2}'
        exit 1
    fi

    serial="$(printf '%s\n' "$out" | awk 'NR>1 && NF==2 {print $1; exit}')"
    state="$(printf '%s\n' "$out" | awk 'NR>1 && NF==2 {print $2; exit}')"
    SERIAL="$serial"
    check_device_state "$SERIAL" "$state"
}

check_device_state() {
    local serial="$1" state="$2"
    case "$state" in
        device) ;;
        unauthorized)
            err "$(m check_device_state_01 "$serial")"
            say "$(m check_device_state_02)"
            say "$(m check_device_state_03)"
            exit 1
            ;;
        offline)
            err "$(m check_device_state_04 "$serial")"
            say "$(m check_device_state_05)"
            exit 1
            ;;
        *)
            err "$(m check_device_state_06 "$serial" "$state")"
            exit 1
            ;;
    esac
}

load_device_info() {
    ANDROID_VER="$(getprop ro.build.version.release)"
    ONEUI_RAW="$(getprop ro.build.version.oneui)"
    SEM_RAW="$(getprop ro.build.version.sem)"
    MODEL="$(getprop ro.product.model)"
    DEVICE_CODE="$(getprop ro.product.device)"
    PDA="$(getprop ro.build.PDA)"
    [ -z "$MODEL" ] && MODEL="desconhecido"
    [ -z "$ANDROID_VER" ] && ANDROID_VER="desconhecido"

    ONEUI_LABEL=""
    ONEUI_MAJOR=0
    case "$ONEUI_RAW" in
        ''|*[!0-9]*) ;;
        *)
            ONEUI_MAJOR=$((ONEUI_RAW / 10000))
            ONEUI_MINOR=$(((ONEUI_RAW % 10000) / 100))
            ONEUI_LABEL="$ONEUI_MAJOR.$ONEUI_MINOR"
            ;;
    esac
    if [ -z "$ONEUI_LABEL" ]; then
        case "$SEM_RAW" in
            ''|*[!0-9]*) ONEUI_LABEL="desconhecida" ;;
            *)
                ONEUI_LABEL="sem=$SEM_RAW"
                ;;
        esac
    fi
}

print_device_header() {
    printf '%s%s%s\n' "$C_BOLD" "$MODEL ($DEVICE_CODE)" "$C_RESET"
    printf '  Android %s | One UI %s\n' "$ANDROID_VER" "$ONEUI_LABEL"
    [ -n "$PDA" ] && printf '  build %s\n' "$PDA"
    printf '  serial %s\n' "$SERIAL"

    if [ "$ONEUI_MAJOR" -gt 9 ] 2>/dev/null; then
        warn "$(m print_device_header_01 "$ONEUI_LABEL")"
        warn "$(m print_device_header_02)"
    fi
}

load_packages() {
    step "$(m load_packages_01)"
    PKG_INSTALLED="$(work_file installed.txt)"
    PKG_KNOWN="$(work_file known.txt)"

    sh_run pm list packages --user 0 \
        | sed -n 's/^package://p' \
        | sort -u > "$PKG_INSTALLED"

    sh_run pm list packages -u --user 0 \
        | sed -n 's/^package://p' \
        | sort -u > "$PKG_KNOWN"

    if [ ! -s "$PKG_KNOWN" ]; then
        err "$(m load_packages_02)"
        exit 1
    fi

    dim "$(m load_packages_03 "$(wc -l < "$PKG_INSTALLED" | tr -d ' ')" "$(wc -l < "$PKG_KNOWN" | tr -d ' ')")"
}

is_installed() { grep -Fxq "$1" "$PKG_INSTALLED" 2>/dev/null; }
is_known()     { grep -Fxq "$1" "$PKG_KNOWN" 2>/dev/null; }

# ---------------------------------------------------------------------------
# política de segurança
# ---------------------------------------------------------------------------

# Pacotes que este script nunca toca, mesmo que apareçam numa lista.
is_denied() {
    case "$1" in
        android) return 0 ;;

        # Android / Google core
        com.google.android.gms|com.google.android.gms.*) return 0 ;;
        com.google.android.gsf|com.google.android.gsf.*) return 0 ;;
        com.android.vending|com.android.vending.*) return 0 ;;
        com.android.systemui|com.android.systemui.*) return 0 ;;
        com.android.settings|com.android.settings.*) return 0 ;;
        com.android.shell|com.android.shell.*) return 0 ;;
        com.android.permissioncontroller|com.android.permissioncontroller.*) return 0 ;;
        com.google.android.webview|com.android.webview) return 0 ;;
        com.android.phone|com.android.phone.*) return 0 ;;
        com.android.server.telecom|com.android.server.telecom.*) return 0 ;;
        com.android.providers.telephony|com.android.providers.telephony.*) return 0 ;;
        com.android.providers.contacts|com.android.providers.contacts.*) return 0 ;;
        com.android.providers.media|com.android.providers.media.*) return 0 ;;
        com.android.providers.downloads|com.android.providers.downloads.*) return 0 ;;
        com.android.documentsui|com.android.documentsui.*) return 0 ;;
        com.android.launcher3|com.android.launcher3.*) return 0 ;;
        com.android.inputmethod.latin) return 0 ;;

        # Samsung core / conectividade / boot
        com.samsung.android.SettingsReceiver) return 0 ;;
        com.samsung.android.incallui) return 0 ;;
        com.samsung.android.dialer) return 0 ;;
        com.samsung.android.communicationservice) return 0 ;;
        com.samsung.android.networkstack|com.samsung.android.networkstack.*) return 0 ;;
        com.samsung.android.wifi|com.samsung.android.wifi.*) return 0 ;;
        com.samsung.android.ConnectivityOverlay) return 0 ;;
        com.samsung.android.ConnectivityUxOverlay) return 0 ;;
        com.samsung.android.timezone|com.samsung.android.timezone.*) return 0 ;;
        com.samsung.networkui) return 0 ;;
        com.samsung.android.mtp) return 0 ;;
        com.samsung.android.storage.watchstoragemanager) return 0 ;;
        com.samsung.android.app.soundpicker) return 0 ;;
        com.samsung.android.applock) return 0 ;;
        com.samsung.android.clipboarduiservice) return 0 ;;
        com.sec.android.app.simsettingmgr) return 0 ;;
        com.samsung.android.honeyboard) return 0 ;;            # teclado Samsung
        com.samsung.android.app.launcher|com.sec.android.app.launcher) return 0 ;;  # One UI Home
        com.samsung.android.kgclient) return 0 ;;             # remove = overlay de bloqueio do aparelho
        com.samsung.android.sm.policy) return 0 ;;
        com.samsung.android.app.telephonyui) return 0 ;;
        com.samsung.android.ims|com.samsung.android.ims.*) return 0 ;;
        com.sec.ims|com.sec.ims.*) return 0 ;;
        com.sec.epdg|com.sec.epdg.*) return 0 ;;
        com.sec.unifiedwfc) return 0 ;;                        # Wi-Fi calling
        com.samsung.android.app.aodservice) return 0 ;;        # AOD + relógio da lockscreen

        # UAD-ng classifica como "Unsafe": remover quebra Settings/tela
        com.android.bips) return 0 ;;                          # print service: Settings crasha
        com.android.internal.display.cutout.emulation.*) return 0 ;;  # overlays do recorte de tela
    esac
    return 1
}

# ---------------------------------------------------------------------------
# listas
# ---------------------------------------------------------------------------

strip_line() {
    # remove comentário e espaços em volta
    printf '%s' "$1" | sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//'
}

list_presets() {
    local f
    for f in "$LISTS_DIR"/*.txt; do
        [ -f "$f" ] || continue
        basename "$f" .txt
    done
}

preset_path() {
    printf '%s/%s.txt' "$LISTS_DIR" "$1"
}

# Lê pacotes de um preset e imprime um por linha.
read_preset() {
    local path="$1" line pkg
    [ -f "$path" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        pkg="$(strip_line "$line")"
        [ -n "$pkg" ] && printf '%s\n' "$pkg"
    done < "$path"
}

# Monta TARGET_FILE a partir de --only ou do preset.
build_target_list() {
    local preset="$1" path out
    out="$(work_file target.txt)"
    : > "$out"

    if [ -n "$ONLY" ]; then
        printf '%s\n' "$ONLY" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
            | sed '/^$/d' > "$out"
        TARGET_LABEL="custom (--only)"
        TARGET_FILE="$out"
        return 0
    fi

    path="$(preset_path "$preset")"
    [ -f "$path" ] || return 1
    read_preset "$path" > "$out" || true
    TARGET_LABEL="preset $preset"
    TARGET_FILE="$out"
    return 0
}

# Aplica --skip e devolve o caminho final em FILTERED_FILE.
filter_skip() {
    local out="$1" skipfile filtered
    filtered="$(work_file filtered.txt)"
    if [ -z "$SKIP" ]; then
        cp "$out" "$filtered"
        FILTERED_FILE="$filtered"
        return 0
    fi
    skipfile="$(work_file skip.txt)"
    printf '%s\n' "$SKIP" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
        | sed '/^$/d' | sort -u > "$skipfile"
    if [ -s "$out" ]; then
        grep -F -x -v -f "$skipfile" "$out" > "$filtered" || true
    else
        : > "$filtered"
    fi
    FILTERED_FILE="$filtered"
    return 0
}

# ---------------------------------------------------------------------------
# ações
# ---------------------------------------------------------------------------

ensure_session_log() {
    [ -n "$SESSION_LOG" ] && return 0
    mkdir -p "$LOG_DIR" || die "$(m die_mkdir_log "$LOG_DIR")"
    SESSION_LOG="$LOG_DIR/session-$(date +%Y%m%d-%H%M%S).tsv"
    printf 'epoch\taction\tpackage\tcontext\n' >> "$SESSION_LOG"
}

record_action() {
    local pkg="$1" action="$2" context="$3" tmp
    ensure_session_log
    printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$action" "$pkg" "$context" >> "$SESSION_LOG"

    mkdir -p "$DATA_DIR" || return 0
    tmp="${STATE_FILE}.tmp.$$"
    if [ -f "$STATE_FILE" ]; then
        awk -F'\t' -v p="$pkg" '$2 != p' "$STATE_FILE" > "$tmp" 2>/dev/null || true
    else
        : > "$tmp"
    fi
    printf '%s\t%s\n' "$action" "$pkg" >> "$tmp"
    mv "$tmp" "$STATE_FILE"
}

apply_one() {
    local pkg="$1" context="$2" out action label
    if is_denied "$pkg"; then
        warn "$(m apply_one_01 "$pkg")"
        BLOCKED=$((BLOCKED + 1))
        return 0
    fi
    case "$pkg" in
        *[!A-Za-z0-9._]*|'') err "$(m apply_bad_name "$pkg")"; FAILED=$((FAILED + 1)); return 0 ;;
    esac
    if ! is_known "$pkg"; then
        MISSING=$((MISSING + 1))
        [ "$VERBOSE" -eq 1 ] && dim "$(m verbose_not_here "$pkg")"
        return 0
    fi
    if ! is_installed "$pkg"; then
        ALREADY=$((ALREADY + 1))
        [ "$VERBOSE" -eq 1 ] && dim "$(m verbose_already "$pkg")"
        return 0
    fi
    label="$(package_label "$pkg")"
    if [ "$DRY_RUN" -eq 1 ]; then
        print_pkg "~" "$pkg" "$label"
        WILL=$((WILL + 1))
        return 0
    fi

    if [ "$METHOD" = "disable" ]; then
        out="$(sh_run pm disable-user --user 0 "$pkg")"
        case "$out" in
            *disabled*) action="DISABLED" ;;
            *) action="FAILED" ;;
        esac
    else
        out="$(sh_run pm uninstall --user 0 "$pkg")"
        case "$out" in
            *Success*)
                action="REMOVED"
                ;;
            *"not installed for"*)
                action="SKIPPED"
                ;;
            *)
                # firmware novo pode bloquear uninstall de app de sistema:
                # cai para disable, que é reversível e mantém os dados.
                out="$(sh_run pm disable-user --user 0 "$pkg")"
                case "$out" in
                    *disabled*) action="DISABLED" ;;
                    *) action="FAILED" ;;
                esac
                ;;
        esac
    fi

    case "$action" in
        REMOVED)
            suf=""; [ -n "$label" ] && suf="  — $label"
            ok "$(m apply_one_02 "$pkg" "$suf")"
            REMOVED=$((REMOVED + 1))
            record_action "$pkg" "REMOVED" "$context"
            ;;
        DISABLED)
            suf=""; [ -n "$label" ] && suf="  — $label"
            ok "$(m apply_one_03 "$pkg" "$suf")"
            DISABLED=$((DISABLED + 1))
            record_action "$pkg" "DISABLED" "$context"
            ;;
        SKIPPED)
            ALREADY=$((ALREADY + 1))
            [ "$VERBOSE" -eq 1 ] && dim "$(m verbose_already "$pkg")"
            ;;
        *)
            err "$(m apply_one_04 "$pkg" "$out")"
            FAILED=$((FAILED + 1))
            ;;
    esac
}

cmd_apply() {
    local preset="${1:-}" pkg total
    if [ -z "$preset" ] && [ -z "$ONLY" ]; then
        err "$(m apply_01)"
        say "$(m apply_02 "$(list_presets | tr '\n' ' ')")"
        exit 1
    fi
    if [ -n "$preset" ] && [ -z "$ONLY" ] && [ ! -f "$(preset_path "$preset")" ]; then
        err "$(m apply_03 "$preset")"
        say "$(m apply_04 "$(list_presets | tr '\n' ' ')")"
        exit 1
    fi

    require_adb
    select_device
    load_device_info
    say ""
    print_device_header
    say ""

    build_target_list "$preset" || exit 1
    filter_skip "$TARGET_FILE"
    sort -u "$FILTERED_FILE" -o "$FILTERED_FILE" 2>/dev/null || true
    total="$(wc -l < "$FILTERED_FILE" | tr -d ' ')"

    if [ "$total" -eq 0 ]; then
        warn "$(m apply_05)"
        exit 0
    fi

    load_packages

    REMOVED=0; DISABLED=0; ALREADY=0; MISSING=0; FAILED=0; BLOCKED=0; WILL=0

    step "$(m apply_06 "$TARGET_LABEL")"
    say "$(m apply_07 "$([ "$METHOD" = disable ] && echo 'desativar' || echo 'desinstalar para o usuário 0')")"
    say "$(m apply_08 "$total")"
    say ""

    # prévia é obrigatória: primeiro o que iria, depois confirma e só então aplica
    DRY_RUN=1
    while IFS= read -r pkg; do
        [ -z "$pkg" ] && continue
        apply_one "$pkg" "$TARGET_LABEL"
    done < "$FILTERED_FILE"
    DRY_RUN=0

    say ""
    say "$(m apply_09 "$WILL")"
    say "$(m apply_10 "$ALREADY")"
    say "$(m apply_11 "$MISSING")"
    [ "$BLOCKED" -gt 0 ] && warn "$(m blocked_count "$BLOCKED")"

    if [ "$WILL" -eq 0 ]; then
        say ""
        say "$(m apply_12)"
        exit 0
    fi

    if [ "$ASSUME_YES" -ne 1 ]; then
        say ""
        say "$(m apply_13)"
        printf "$(m apply_type_yes "$C_BOLD" "$C_RESET")"
        read -r answer
        case "$answer" in
            sim|SIM|Sim|s|S|y|Y|yes|YES) ;;
            *) warn "$(m cancelled)"; exit 0 ;;
        esac
    fi

    REMOVED=0; DISABLED=0; ALREADY=0; MISSING=0; FAILED=0; BLOCKED=0
    step "$(m apply_14 "$TARGET_LABEL")"
    while IFS= read -r pkg; do
        [ -z "$pkg" ] && continue
        apply_one "$pkg" "$TARGET_LABEL"
    done < "$FILTERED_FILE"

    say ""
    step "$(m apply_15)"
    say "$(m apply_16 "$REMOVED")"
    say "$(m apply_17 "$DISABLED")"
    say "$(m apply_18 "$ALREADY")"
    say "$(m apply_19 "$MISSING")"
    [ "$BLOCKED" -gt 0 ] && warn "$(m blocked_count "$BLOCKED")"
    [ "$FAILED" -gt 0 ] && err "$(m failed_count "$FAILED")"

    if [ $((REMOVED + DISABLED)) -gt 0 ]; then
        say ""
        say "$(m apply_20 "$SESSION_LOG")"
        say "$(m apply_21)"
        say "$(m apply_22)"
    fi
}

cmd_restore() {
    require_adb
    select_device
    load_device_info
    say ""
    print_device_header

    if [ ! -s "$STATE_FILE" ]; then
        ok "$(m restore_01 "$STATE_FILE")"
        return 0
    fi

    local total action pkg out done_count failed_count
    total="$(wc -l < "$STATE_FILE" | tr -d ' ')"
    step "$(m restore_02 "$total")"

    if [ "$ASSUME_YES" -ne 1 ] && [ "$DRY_RUN" -ne 1 ]; then
        printf 'Digite %ssim%s para restaurar: ' "$C_BOLD" "$C_RESET"
        read -r answer
        case "$answer" in
            sim|SIM|Sim|s|S|y|Y|yes|YES) ;;
            *) warn "$(m cancelled)"; exit 0 ;;
        esac
    fi

    tmp="${STATE_FILE}.restore.$$"
    : > "$tmp"
    done_count=0
    failed_count=0

    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        action="$(printf '%s' "$line" | cut -f1)"
        pkg="$(printf '%s' "$line" | cut -f2)"
        [ -z "$pkg" ] && continue

        case "$action" in
            REMOVED)
                if [ "$DRY_RUN" -eq 1 ]; then
                    printf '  ~ reinstalar %s\n' "$pkg"
                    done_count=$((done_count + 1))
                    continue
                fi
                out="$(sh_run cmd package install-existing --user 0 "$pkg")"
                case "$out" in
                    *installed*|*Success*)
                        ok "$(m restore_03 "$pkg")"
                        done_count=$((done_count + 1))
                        ;;
                    *)
                        err "$(m restore_04 "$pkg" "$out")"
                        failed_count=$((failed_count + 1))
                        printf '%s\n' "$line" >> "$tmp"
                        ;;
                esac
                ;;
            DISABLED)
                if [ "$DRY_RUN" -eq 1 ]; then
                    printf '%s\n' "$(m restore_reenable "$pkg")"
                    done_count=$((done_count + 1))
                    continue
                fi
                out="$(sh_run pm enable "$pkg")"
                case "$out" in
                    *enabled*|*Success*)
                        ok "$(m restore_05 "$pkg")"
                        done_count=$((done_count + 1))
                        ;;
                    *)
                        err "$(m restore_06 "$pkg" "$out")"
                        failed_count=$((failed_count + 1))
                        printf '%s\n' "$line" >> "$tmp"
                        ;;
                esac
                ;;
            *)
                printf '%s\n' "$line" >> "$tmp"
                ;;
        esac
    done < "$STATE_FILE"

    if [ "$DRY_RUN" -ne 1 ]; then
        mv "$tmp" "$STATE_FILE"
        say ""
        say "$(m restore_07 "$done_count")"
        [ "$failed_count" -gt 0 ] && err "$(m failed_count "$failed_count")"
        say "$(m restore_08)"
    else
        rm -f "$tmp"
    fi
}

cmd_status() {
    require_adb
    select_device
    load_device_info
    say ""
    print_device_header
    say ""

    load_packages
    say "$(m status_01 "$(wc -l < "$PKG_INSTALLED" | tr -d ' ')")"

